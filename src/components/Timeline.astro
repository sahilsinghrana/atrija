---
import timelineData from '../content/timeline.json';
---

<section id="timeline" class="section timeline-section">
  <div class="section-inner">
    <div class="section-label reveal-left">Van Gogh</div>
    <h2 class="reveal">A Life in <em>Light</em> &amp; Color</h2>
    <p class="timeline-intro reveal">
      From a failed art dealer to the most influential painter of the 19th century —
      Vincent van Gogh's brief, turbulent life burned with a creative fire that
      changed art forever.
    </p>

    <div class="timeline-filter reveal" role="group" aria-label="Filter timeline by category">
      {Object.entries(timelineData.categories).map(([key, cat]) => (
        <button
          class="timeline-filter-btn"
          data-category={key}
          style={`--cat-color: ${cat.color}`}
          aria-label={`Show ${cat.label} events`}
        >
          {cat.label}
        </button>
      ))}
      <button
        class="timeline-filter-btn active"
        data-category="all"
        style="--cat-color: var(--text-tertiary)"
        aria-label="Show all events"
      >
        All
      </button>
    </div>

    <div class="timeline">
      {timelineData.milestones.map((m, i) => (
        <div
          class="timeline-item reveal"
          data-category={m.category}
          data-index={i}
          style={`--delay: ${i * 0.06}s`}
        >
          <div class="timeline-marker" style={`--cat-color: ${timelineData.categories[m.category].color}`}>
            <div class="timeline-dot"></div>
          </div>
          <div class="timeline-card">
            <div class="timeline-year">{m.year}</div>
            <div class="timeline-title">{m.title}</div>
            <div class="timeline-desc">{m.description}</div>
            <span class="timeline-cat-badge" style={`--cat-color: ${timelineData.categories[m.category].color}`}>
              {timelineData.categories[m.category].label}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  (function() {
    var filterBtns = document.querySelectorAll('.timeline-filter-btn');
    var items = document.querySelectorAll('.timeline-item');
    if (!filterBtns.length || !items.length) return;

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var cat = btn.dataset.category;
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');

        items.forEach(function(item) {
          if (cat === 'all' || item.dataset.category === cat) {
            item.style.display = '';
            // Re-trigger reveal animation
            item.classList.remove('visible');
            void item.offsetWidth; // force reflow
            setTimeout(function() { item.classList.add('visible'); }, 50);
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  })();
</script>

<style>
  .timeline-section {
    --timeline-line: rgba(255,255,255,0.08);
    --timeline-dot-size: 14px;
    --timeline-gap: 2.5rem;
  }

  .timeline-intro {
    max-width: 560px;
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-style: italic;
    margin-bottom: var(--space-2xl);
  }

  .timeline-filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
  }

  .timeline-filter-btn {
    padding: 0.35rem 1rem;
    border-radius: 100px;
    border: 1px solid rgba(255,255,255,0.1);
    background: transparent;
    color: var(--text-tertiary);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .timeline-filter-btn:hover {
    border-color: var(--cat-color, var(--text-tertiary));
    color: var(--cat-color, var(--text-primary));
  }

  .timeline-filter-btn.active {
    background: rgba(255,255,255,0.06);
    border-color: var(--cat-color, var(--text-tertiary));
    color: var(--cat-color, var(--text-primary));
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--timeline-dot-size) / 2);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--timeline-line);
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--timeline-gap);
    transition: opacity 0.3s ease;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0.35rem;
    width: var(--timeline-dot-size);
    height: var(--timeline-dot-size);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(-50%) translateX(-0.5px);
  }

  .timeline-dot {
    width: var(--timeline-dot-size);
    height: var(--timeline-dot-size);
    border-radius: 50%;
    background: var(--cat-color, var(--accent-gold));
    border: 3px solid var(--bg);
    box-shadow: 0 0 12px var(--cat-color, var(--accent-gold));
    flex-shrink: 0;
  }

  .timeline-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .timeline-card:hover {
    background: var(--bg-card-hover);
    border-color: rgba(255,255,255,0.1);
  }

  .timeline-year {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: var(--space-xs);
  }

  .timeline-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .timeline-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  .timeline-cat-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--cat-color, var(--text-tertiary));
    padding: 0.15rem 0.6rem;
    border-radius: 100px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02);
  }

  /* Reveal animation with stagger */
  .timeline-section .reveal {
    transition-delay: var(--delay, 0s);
  }

  @media (max-width: 767px) {
    .timeline {
      padding-left: 1.5rem;
    }
    .timeline-marker {
      left: -1.5rem;
    }
    .timeline-card {
      padding: var(--space-md);
    }
    .timeline-title {
      font-size: var(--text-md);
    }
    .timeline-filter {
      gap: 0.35rem;
    }
    .timeline-filter-btn {
      padding: 0.3rem 0.75rem;
      font-size: 0.65rem;
    }
  }
</style>
