---
import galleryData from '../content/gallery.json';
---

<section id="gallery" class="section gallery-section">
  <div class="section-inner">
    <div class="section-label reveal-left">The Gallery</div>
    <h2 class="reveal">Van Gogh's <em>masterworks</em></h2>
    <p class="reveal">Explore the paintings that inspire this site's impressionist vision. Each work connects to a philosophical theme woven throughout this experience.</p>

    <div class="gallery-carousel reveal" id="gallery-carousel">
      <button class="gallery-arrow gallery-arrow-left" aria-label="Previous painting" id="gallery-prev">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="gallery-track" id="gallery-track">
        {galleryData.paintings.map((painting, i) => (
          <div class="gallery-card" data-index={i}>
            <div class="gallery-image-wrap">
              <img
                loading="lazy"
                decoding="async"
                src={painting.imageUrl}
                alt={painting.title + ' (' + painting.year + ') by Vincent van Gogh'}
                class="gallery-image"
                onerror="this.parentElement.innerHTML='<div class=\\'gallery-image-fallback\\'><span>🎨</span><br/>' + this.alt + '</div>'"
              />
            </div>
            <div class="gallery-info">
              <div class="gallery-title">{painting.title}</div>
              <div class="gallery-year">{painting.year}</div>
              <div class="gallery-theme-tag">{painting.theme}</div>
              <p class="gallery-description">{painting.description}</p>
            </div>
          </div>
        ))}
      </div>
      <button class="gallery-arrow gallery-arrow-right" aria-label="Next painting" id="gallery-next">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <div class="gallery-dots" id="gallery-dots">
      {galleryData.paintings.map((_p, i) => (
        <button class={'gallery-dot' + (i === 0 ? ' active' : '')} data-index={i} aria-label={'Painting ' + (i + 1)} />
      ))}
    </div>
  </div>
</section>

<style>
.gallery-section { padding-bottom: 6rem; }
.gallery-carousel {
  position: relative;
  margin-top: var(--space-lg);
  overflow: hidden;
}
.gallery-track {
  display: flex;
  gap: 24px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding: 1rem 0;
}
.gallery-track::-webkit-scrollbar { display: none; }
.gallery-card {
  flex: 0 0 85vw;
  max-width: 400px;
  scroll-snap-align: start;
  background: rgba(255,255,255,0.03);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.06);
}
@media (min-width: 768px) {
  .gallery-card { flex: 0 0 400px; max-width: 400px; }
}
.gallery-image-wrap {
  width: 100%;
  aspect-ratio: 4/3;
  overflow: hidden;
  background: rgba(0,0,0,0.3);
}
.gallery-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.gallery-image-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  font-size: 0.85rem;
  text-align: center;
  padding: 1rem;
}
.gallery-image-fallback span { font-size: 2rem; margin-bottom: 0.5rem; }
.gallery-info { padding: 1.25rem; }
.gallery-title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--text-primary);
}
.gallery-year {
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--text-tertiary);
  margin-top: 0.2rem;
}
.gallery-theme-tag {
  display: inline-block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent-gold);
  background: rgba(255,213,79,0.08);
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  margin-top: 0.5rem;
}
.gallery-description {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-top: 0.75rem;
}
.gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.15);
  background: rgba(0,0,0,0.5);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.3s, border-color 0.3s;
}
.gallery-arrow:hover { background: rgba(0,0,0,0.7); border-color: rgba(255,255,255,0.3); }
.gallery-arrow-left { left: 8px; }
.gallery-arrow-right { right: 8px; }
@media (max-width: 767px) { .gallery-arrow { display: none; } }
.gallery-dots {
  display: flex;
  gap: 6px;
  justify-content: center;
  margin-top: var(--space-sm);
}
.gallery-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.2);
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
  padding: 0;
}
.gallery-dot.active { background: var(--accent-gold); transform: scale(1.2); }
</style>

<script>
(function() {
  var track = document.getElementById('gallery-track');
  var prev = document.getElementById('gallery-prev');
  var next = document.getElementById('gallery-next');
  var dots = document.querySelectorAll('.gallery-dot');
  var cards = document.querySelectorAll('.gallery-card');
  if (!track || !cards.length) return;
  function scrollToCard(index) {
    if (index < 0 || index >= cards.length) return;
    var card = cards[index];
    track.scrollTo({ left: card.offsetLeft - track.offsetLeft - 12, behavior: 'smooth' });
    dots.forEach(function(d, i) { d.classList.toggle('active', i === index); });
  }
  prev && prev.addEventListener('click', function() {
    var current = parseInt(document.querySelector('.gallery-dot.active')?.dataset.index || 0);
    scrollToCard(current - 1);
  });
  next && next.addEventListener('click', function() {
    var current = parseInt(document.querySelector('.gallery-dot.active')?.dataset.index || 0);
    scrollToCard(current + 1);
  });
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() { scrollToCard(parseInt(dot.dataset.index)); });
  });
  track.addEventListener('scroll', function() {
    var trackRect = track.getBoundingClientRect();
    var trackCenter = trackRect.left + trackRect.width / 2;
    var closest = 0, closestDist = Infinity;
    cards.forEach(function(card, i) {
      var cardRect = card.getBoundingClientRect();
      var cardCenter = cardRect.left + cardRect.width / 2;
      var dist = Math.abs(cardCenter - trackCenter);
      if (dist < closestDist) { closestDist = dist; closest = i; }
    });
    dots.forEach(function(d, i) { d.classList.toggle('active', i === closest); });
  }, { passive: true });
  document.addEventListener('keydown', function(e) {
    var gallery = document.getElementById('gallery-carousel');
    if (!gallery) return;
    var rect = gallery.getBoundingClientRect();
    if (rect.top > window.innerHeight || rect.bottom < 0) return;
    if (e.key === 'ArrowLeft') { e.preventDefault(); prev && prev.click(); }
    if (e.key === 'ArrowRight') { e.preventDefault(); next && next.click(); }
  });
})();
</script>
