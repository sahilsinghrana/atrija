      var moonEl = document.getElementById('asciiMoon');
      var shadow = document.getElementById('moonShadow');
      if (!moonEl || !shadow) return;

      moonEl.textContent = moonArt;

      // ── Moon phase calculation ──
      function getMoonPhaseName(phase) {
        if (phase >= 0 && phase < 0.03) return "New Moon";
        if (phase >= 0.03 && phase < 0.22) return "Waxing Crescent";
        if (phase >= 0.22 && phase < 0.28) return "First Quarter";
        if (phase >= 0.28 && phase < 0.48) return "Waxing Gibbous";
        if (phase >= 0.48 && phase < 0.52) return "Full Moon";
        if (phase >= 0.52 && phase < 0.72) return "Waning Gibbous";
        if (phase >= 0.72 && phase < 0.78) return "Last Quarter";
        if (phase >= 0.78 && phase < 0.97) return "Waning Crescent";
        return "New Moon";
      }

      function calcMoonPhase(date) {
        var knownNewMoon = new Date(2000, 0, 6, 18, 14, 0);
        var lunarCycle = 29.53058867;
        var daysSince = (date.getTime() - knownNewMoon.getTime()) / (1000 * 60 * 60 * 24);
        var phase = ((daysSince % lunarCycle) + lunarCycle) % lunarCycle;
        var phaseFraction = phase / lunarCycle;
        return {
          phase: phaseFraction,
          illumination: (1 - Math.cos(phaseFraction * 2 * Math.PI)) / 2 * 100,
          phaseName: getMoonPhaseName(phaseFraction)
        };
      }

      function updateShadow(date) {
        var moonData = calcMoonPhase(date);
        var illumination = moonData.illumination;
        var phase = moonData.phase;
        var translateValue;
        if (phase < 0.5) {
          translateValue = -(100 - illumination);
        } else {
          translateValue = 100 - illumination;
        }
        shadow.style.transform = 'translateX(' + translateValue + '%';
        return moonData;
      }

      // Initial display from real date
      updateShadow(new Date());

      // Demo: cycle through phases smoothly
      var demoPhase = 0;
      setInterval(function() {
        demoPhase = (demoPhase + 0.125) % 1.0;
        var syntheticDate = new Date();
        syntheticDate.setTime(syntheticDate.getTime() + demoPhase * 29.53058867 * 24 * 60 * 60 * 1000);
        updateShadow(syntheticDate);
      }, 5000);
    })();
  </script>

