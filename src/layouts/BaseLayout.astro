---
const { title = "अत्रिज", description = "An impressionist journey through light, philosophy, and the cosmos." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/loader.css" />
  <style>
    /* ═══════════════════════════════════════
       DESIGN TOKENS
    ═══════════════════════════════════════ */
    :root {
      /* Colors */
      --bg: #08080f;
      --bg-surface: rgba(255,255,255,0.02);
      --bg-card: rgba(255,255,255,0.04);
      --bg-card-hover: rgba(255,255,255,0.07);
      --border: rgba(255,255,255,0.06);
      --border-accent: rgba(255,213,79,0.25);

      --text-primary: #f0ece4;
      --text-secondary: rgba(240,236,228,0.72);
      --text-tertiary: rgba(240,236,228,0.45);
      --text-quote: #e8e4dc;

      --accent-gold: #ffd54f;
      --accent-gold-dim: rgba(255,213,79,0.08);
      --accent-blue: #4fc3f7;
      --accent-coral: #ff8a65;
      --accent-violet: #b388ff;
      --sage: #80cbc4;

      /* Typography Scale (1.25 ratio) */
      --text-xs: clamp(0.65rem, 0.8vw, 0.75rem);
      --text-sm: clamp(0.8rem, 1vw, 0.875rem);
      --text-base: clamp(0.95rem, 1.2vw, 1.05rem);
      --text-md: clamp(1.1rem, 1.5vw, 1.25rem);
      --text-lg: clamp(1.3rem, 2vw, 1.6rem);
      --text-xl: clamp(1.6rem, 2.8vw, 2.2rem);
      --text-2xl: clamp(2rem, 4vw, 3rem);
      --text-3xl: clamp(2.8rem, 6vw, 4.5rem);
      --text-hero: clamp(3.5rem, 12vw, 7rem);

      /* Spacing */
      --space-xs: 0.25rem;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2.5rem;
      --space-2xl: 4rem;
      --space-3xl: 6rem;

      /* Fonts */
      --font-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-devanagari: 'Noto Sans Devanagari', sans-serif;

      /* Layout */
      --max-w: 680px;
      --max-w-wide: 820px;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
    }

    /* ═══════════════════════════════════════
       RESET & BASE
    ═══════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: auto; -webkit-text-size-adjust: 100%; }
    body {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      line-height: 1.75;
      background: var(--bg);
      color: var(--text-primary);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
    }

    /* ═══════════════════════════════════════
       LAYOUT SHELL
    ═══════════════════════════════════════ */
    #canvas-container { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    main { position: relative; z-index: 1; }

    /* ═══════════════════════════════════════
       HERO
    ═══════════════════════════════════════ */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--space-2xl) var(--space-lg);
      position: relative;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 50%;
      transform: translateX(-50%);
      width: 1px; height: 60px;
      background: linear-gradient(to bottom, var(--accent-gold), transparent);
      opacity: 0.3;
    }

    /* ═══════════════════════════════════════
       LOGO / TITLE
    ═══════════════════════════════════════ */
    .logo-sanskrit {
      font-family: var(--font-devanagari);
      font-size: var(--text-hero);
      font-weight: 700;
      line-height: 1.05;
      margin-bottom: var(--space-xs);
      letter-spacing: 0.02em;
      background: linear-gradient(135deg, var(--accent-gold) 0%, #fff8e1 40%, var(--accent-gold) 70%, #ffe082 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200% 200%;
    }
    .logo-subtitle {
      font-family: var(--font-serif);
      font-size: var(--text-sm);
      font-style: italic;
      font-weight: 400;
      color: var(--text-tertiary);
      letter-spacing: 0.1em;
      margin-bottom: var(--space-sm);
      text-transform: uppercase;
    }
    .logo-tagline {
      font-family: var(--font-serif);
      font-size: var(--text-md);
      color: var(--text-secondary);
      font-style: italic;
      font-weight: 400;
      max-width: 500px;
      line-height: 1.6;
    }
    .logo-tagline em {
      color: var(--accent-gold);
      font-style: italic;
      font-weight: 500;
    }

    .hero .scroll-hint {
      position: absolute;
      bottom: var(--space-lg);
      left: 50%;
      transform: translateX(-50%);
      color: var(--text-tertiary);
      font-size: var(--text-xs);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 500;
      animation: fadeUp 2.5s ease-in-out infinite;
    }
    @keyframes fadeUp {
      0%, 100% { opacity: 0.25; transform: translateX(-50%) translateY(0); }
      50% { opacity: 0.7; transform: translateX(-50%) translateY(-6px); }
    }

    /* ═══════════════════════════════════════
       SECTIONS
    ═══════════════════════════════════════ */
    .section {
      padding: var(--space-2xl) var(--space-lg);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .section:last-of-type { padding-bottom: var(--space-lg); }
    .section-inner {
      width: 100%;
      max-width: var(--max-w);
    }

    /* Section Label */
    .section-label {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-gold);
      margin-bottom: var(--space-md);
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-accent);
      max-width: 60px;
    }

    /* ═══════════════════════════════════════
       TYPOGRAPHY — HEADINGS
    ═══════════════════════════════════════ */
    .section h2 {
      font-family: var(--font-serif);
      font-size: var(--text-2xl);
      font-weight: 600;
      line-height: 1.2;
      margin-bottom: var(--space-lg);
      letter-spacing: -0.01em;
    }
    .section h2 em {
      font-style: italic;
      font-weight: 400;
    }

    /* Section-specific heading colors via color theory */
    #today h2 { color: var(--accent-gold); }
    #today h2 em { color: var(--accent-coral); }
    #moon h2 { color: var(--accent-blue); }
    #moon h2 em { color: var(--accent-gold); }
    #philosophy h2 { color: var(--accent-coral); }
    #philosophy h2 em { color: var(--sage); }
    #gita h2 { color: var(--accent-violet); }
    #gita h2 em { color: var(--accent-gold); }
    #shiva h2 { color: var(--sage); }
    #shiva h2 em { color: var(--accent-blue); }
    #art h2 { color: var(--accent-gold); }
    #art h2 em { color: var(--accent-coral); }
    #changelog h2 { color: var(--text-secondary); }
    #changelog h2 em { color: var(--accent-gold); }

    /* ═══════════════════════════════════════
       TYPOGRAPHY — BODY TEXT
    ═══════════════════════════════════════ */
    .section > .section-inner > p {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      color: var(--text-secondary);
      margin-bottom: var(--space-lg);
      max-width: 560px;
      line-height: 1.8;
      font-weight: 400;
    }

    /* ═══════════════════════════════════════
       IMAGE CARDS (text over image background)
    ═══════════════════════════════════════ */
    .image-card {
      position: relative;
      width: 100%;
      margin: var(--space-lg) 0;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      min-height: 220px;
    }
    .image-card .card-bg {
      position: absolute;
      inset: 0;
      background: var(--card-bg-image) center/cover no-repeat;
      opacity: 0.45;
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .image-card:hover .card-bg {
      opacity: 0.6;
      transform: scale(1.03);
    }
    .image-card .card-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(8,8,15,0.25) 0%,
        rgba(8,8,15,0.6) 40%,
        rgba(8,8,15,0.92) 80%,
        rgba(8,8,15,0.98) 100%
      );
    }
    .image-card .card-content {
      position: relative;
      z-index: 1;
      padding: var(--space-2xl) var(--space-lg) var(--space-lg);
    }
    .image-card .card-content p {
      font-family: var(--font-serif);
      font-size: var(--text-md);
      color: var(--text-primary);
      line-height: 1.7;
      margin-bottom: var(--space-sm);
      font-weight: 400;
    }
    .image-card .card-content .source {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      color: var(--text-tertiary);
      font-style: italic;
      font-weight: 400;
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }
    .image-card .card-content .source::before {
      content: '—';
      color: var(--accent-gold);
      opacity: 0.6;
      font-style: normal;
    }

    /* ═══════════════════════════════════════
       FACT CARDS — structured list layout
    ═══════════════════════════════════════ */
    .facts-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      margin: var(--space-lg) 0;
    }
    .fact-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-lg);
      position: relative;
      transition: background 0.3s ease, border-color 0.3s ease;
    }
    .fact-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(255,255,255,0.1);
    }
    .fact-card .fact-number {
      font-family: var(--font-serif);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--accent-gold);
      opacity: 0.5;
      margin-bottom: var(--space-sm);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .fact-card p {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      color: var(--text-secondary);
      line-height: 1.75;
      font-weight: 400;
    }
    .fact-card .source {
      margin-top: var(--space-sm);
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      color: var(--text-tertiary);
      font-style: italic;
      font-weight: 400;
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }
    .fact-card .source::before {
      content: '—';
      color: var(--accent-gold);
      opacity: 0.5;
      font-style: normal;
    }

    /* ═══════════════════════════════════════
       QUOTE BLOCK
    ═══════════════════════════════════════ */
    .quote-block {
      text-align: center;
      padding: var(--space-2xl) var(--space-lg);
      margin: var(--space-xl) 0;
      position: relative;
    }
    .quote-block::before {
      content: '\201C';
      font-family: var(--font-serif);
      font-size: 5rem;
      color: var(--accent-gold);
      opacity: 0.12;
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      line-height: 1;
      font-weight: 700;
    }
    .quote-block p {
      font-family: var(--font-serif);
      font-size: var(--text-lg);
      font-style: italic;
      font-weight: 400;
      color: var(--text-quote);
      line-height: 1.55;
      position: relative;
      z-index: 1;
      max-width: 500px;
      margin: 0 auto;
    }

    /* ═══════════════════════════════════════
       TODAY SECTION
    ═══════════════════════════════════════ */
    .today-fact {
      background: linear-gradient(135deg, var(--accent-gold-dim), rgba(79,195,247,0.06));
      border: 1px solid var(--border-accent);
      border-radius: var(--radius-lg);
      padding: var(--space-xl);
      margin: var(--space-lg) 0;
    }
    .today-fact .theme-tag {
      display: inline-block;
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      font-weight: 500;
      color: var(--text-tertiary);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: var(--space-xs) var(--space-sm);
      margin-bottom: var(--space-md);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .today-fact p {
      font-family: var(--font-serif);
      font-size: var(--text-md);
      color: var(--text-primary);
      line-height: 1.75;
      font-weight: 400;
    }
    .today-fact .source {
      margin-top: var(--space-sm);
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      color: var(--text-tertiary);
      font-style: italic;
    }

    /* ═══════════════════════════════════════
       CHANGELOG
    ═══════════════════════════════════════ */
    .changelog-section { padding-bottom: 0; }
    .changelog-timeline { position: relative; padding-left: 1.5rem; }
    .changelog-timeline::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, var(--accent-gold), var(--border), transparent);
    }
    .changelog-entry {
      position: relative;
      margin-bottom: var(--space-xl);
      padding-bottom: var(--space-lg);
      border-bottom: 1px solid var(--border);
    }
    .changelog-entry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .changelog-entry::before {
      content: '';
      position: absolute;
      left: -1.5rem; top: 0.4rem;
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--accent-gold);
      border: 2px solid var(--bg);
      box-shadow: 0 0 8px rgba(255,213,79,0.3);
      transform: translateX(-4px);
    }
    .changelog-entry-header {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      margin-bottom: var(--space-sm);
      flex-wrap: wrap;
    }
    .changelog-date {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--text-tertiary);
      letter-spacing: 0.04em;
    }
    .changelog-type {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-family: var(--font-sans);
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      line-height: 1.4;
    }
    .changelog-type.type-initial { background: rgba(255,213,79,0.12); color: var(--accent-gold); border: 1px solid rgba(255,213,79,0.2); }
    .changelog-type.type-feature { background: rgba(79,195,247,0.12); color: var(--accent-blue); border: 1px solid rgba(79,195,247,0.2); }
    .changelog-type.type-fix { background: rgba(255,138,101,0.12); color: var(--accent-coral); border: 1px solid rgba(255,138,101,0.2); }
    .changelog-type.type-content { background: rgba(179,136,255,0.12); color: var(--accent-violet); border: 1px solid rgba(179,136,255,0.2); }
    .changelog-type.type-design { background: rgba(128,203,196,0.12); color: var(--sage); border: 1px solid rgba(128,203,196,0.2); }
    .changelog-version {
      font-family: 'Courier New', monospace;
      font-size: var(--text-xs);
      color: var(--text-tertiary);
      background: rgba(255,255,255,0.04);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      margin-left: auto;
    }
    .changelog-desc {
      font-family: var(--font-serif);
      font-size: var(--text-base);
      font-style: italic;
      color: var(--text-primary);
      margin-bottom: var(--space-sm);
      line-height: 1.55;
    }
    .changelog-changes { list-style: none; padding: 0; margin: 0; }
    .changelog-changes li {
      font-family: var(--font-sans);
      font-size: var(--text-sm);
      color: var(--text-secondary);
      padding: var(--space-xs) 0 var(--space-xs) 1.1rem;
      position: relative;
      line-height: 1.6;
    }
    .changelog-changes li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--accent-gold);
      opacity: 0.5;
      font-size: var(--text-xs);
    }
    .changelog-changes li + li { border-top: 1px solid rgba(255,255,255,0.02); }

    /* ═══════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════ */
    footer {
      text-align: center;
      padding: var(--space-lg);
      border-top: 1px solid var(--border);
      color: var(--text-tertiary);
      font-size: var(--text-xs);
      position: relative;
      z-index: 1;
      font-family: var(--font-sans);
    }
    footer .footer-sanskrit {
      font-family: var(--font-devanagari);
      font-size: var(--text-md);
      color: var(--accent-gold);
      opacity: 0.35;
      margin-bottom: var(--space-xs);
      font-weight: 600;
    }

    /* ═══════════════════════════════════════
       RESPONSIVE — Tablet+
    ═══════════════════════════════════════ */
    @media (min-width: 768px) {
      .hero { padding: var(--space-3xl) var(--space-xl); }
      .section { padding: var(--space-3xl) var(--space-xl); }
      .section:last-of-type { padding-bottom: var(--space-2xl); }
      .fact-card { padding: var(--space-xl); }
      .today-fact { padding: var(--space-2xl); }
      .image-card { margin: var(--space-xl) 0; min-height: 280px; }
      .image-card .card-content { padding: var(--space-3xl) var(--space-xl) var(--space-xl); }
      .quote-block { padding: var(--space-3xl) var(--space-xl); }
      .changelog-timeline { padding-left: 2rem; }
      .changelog-entry::before { left: -2rem; }
      footer { padding: var(--space-xl); }
    }

    /* ═══════════════════════════════════════
       ANIMATIONS
    ═══════════════════════════════════════ */
    @keyframes noteFloat {
      0%   { opacity: 0; transform: translateY(0) scale(0.5) rotate(0deg); }
      15%  { opacity: 1; transform: translateY(-10px) scale(1) rotate(-5deg); }
      100% { opacity: 0; transform: translateY(-120px) scale(0.7) rotate(15deg); }
    }
  </style>
</head>
<body>
  <div id="loader">
    <div class="loader-ring"></div>
    <div class="loader-text">Painting the sky<span class="loader-dots"></span></div>
  </div>

  <div id="canvas-container"></div>

  <!-- Flute button -->
  <div id="flute-container" title="Click to play" style="position:fixed;bottom:2rem;right:2rem;z-index:9999;cursor:pointer;width:64px;height:64px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,213,79,0.08);border:1px solid rgba(255,213,79,0.2);-webkit-tap-highlight-color:transparent;">
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:38px;height:38px;">
      <rect x="4" y="20" width="38" height="8" rx="4" fill="#d4a843" opacity="0.9"/>
      <rect x="4" y="21" width="38" height="3" rx="1.5" fill="#e8c060" opacity="0.4"/>
      <circle cx="12" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="19" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="26" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="33" cy="24" r="2" fill="#1a1a1a"/>
      <text x="42" y="14" font-size="14" fill="#ffd54f" opacity="0.7" font-family="serif">♪</text>
      <text x="2" y="38" font-size="10" fill="#ffd54f" opacity="0.4" font-family="serif">♫</text>
    </svg>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-sanskrit">अत्रिज</div>
    An impressionist experience in light &amp; philosophy
  </footer>

  <!-- Flute Click Handler -->
  <script>
    (function() {
      var flute = document.getElementById('flute-container');
      if (!flute) return;
      var symbols = ['♪','♫','♩','♬','♭','♮','♯'];
      var colors = ['#ffd54f','#ff8a65','#4fc3f7','#b388ff','#80cbc4','#fff'];
      flute.addEventListener('click', function(e) {
        var cx = e.clientX || window.innerWidth/2;
        var cy = e.clientY || window.innerHeight/2;
        for (var i = 0; i < 8; i++) {
          (function(idx) {
            setTimeout(function() {
              var n = document.createElement('div');
              n.textContent = symbols[Math.floor(Math.random()*symbols.length)];
              n.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;font-family:serif;font-size:' + (1.2+Math.random()*1.5) + 'rem;color:' + colors[Math.floor(Math.random()*colors.length)] + ';left:' + (cx+(Math.random()-0.5)*120) + 'px;top:' + (cy+(Math.random()-0.5)*60-40) + 'px;animation:noteFloat 2.5s ease-out forwards;';
              document.body.appendChild(n);
              setTimeout(function(){n.remove();},2600);
            }, idx*100);
          })(i);
        }
      });
    })();

    /* Scroll flowers */
    (function() {
      var positions = [
        {x:'3%',y:'35%',color:'#f5c800'},
        {x:'90%',y:'50%',color:'#ff6699'},
        {x:'6%',y:'72%',color:'#cc2242'}
      ];
      var flowers = [], revealed = new Set(), ticking = false;
      positions.forEach(function(pos, i) {
        var el = document.createElement('div');
        el.style.cssText = 'position:fixed;z-index:40;pointer-events:none;opacity:0;transform:scale(0) rotate(-30deg);transition:opacity 0.6s ease,transform 0.6s cubic-bezier(0.34,1.56,0.64,1);left:'+pos.x+';top:'+pos.y+';';
        el.innerHTML = '<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="width:36px;height:36px"><circle cx="20" cy="20" r="6" fill="'+pos.color+'" opacity="0.8"/><g fill="'+pos.color+'" opacity="0.7">';
        for (var p = 0; p < 8; p++) {
          var a = (p/8)*Math.PI*2, px = 20+Math.cos(a)*10, py = 20+Math.sin(a)*10;
          el.innerHTML += '<ellipse cx="'+px+'" cy="'+py+'" rx="4" ry="7" transform="rotate('+(a*180/Math.PI)+','+px+','+py+')"/>';
        }
        el.innerHTML += '</g></svg>';
        document.body.appendChild(el);
        flowers.push({el:el, triggerY:(i+1)*600+500});
      });
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            var sy = window.scrollY;
            flowers.forEach(function(f, idx) {
              if (!revealed.has(idx) && sy > f.triggerY) {
                f.el.style.opacity = '1';
                f.el.style.transform = 'scale(1) rotate(0deg)';
                revealed.add(idx);
              }
            });
            ticking = false;
          });
          ticking = true;
        }
      }, {passive:true});
    })();
  </script>
</body>
</html>
