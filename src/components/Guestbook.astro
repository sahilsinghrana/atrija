---
// Impressionist Visitor Guestbook (idea-034)
// localStorage-backed guestbook — visitors leave short impressions
// that appear as floating, brushstroke-styled text in the UI.
---

<section id="guestbook" class="section guestbook-section">
  <div class="section-inner">
    <div class="section-label reveal-left">VII. Visitor's Impressions</div>
    <h2 class="reveal">Leave Your <em>Mark</em></h2>
    <p class="reveal guestbook-intro">
      Every visitor leaves a trace. Share a thought, impression, or reflection —
      it will remain here, part of this living canvas.
    </p>

    <!-- Entry Form -->
    <form id="guestbook-form" class="guestbook-form reveal" novalidate>
      <div class="guestbook-input-wrap">
        <input
          type="text"
          id="guestbook-name"
          class="guestbook-input"
          placeholder="Your name (optional)"
          maxlength="40"
          autocomplete="off"
          aria-label="Your name"
        />
        <span class="guestbook-input-counter"><span id="name-count">0</span>/40</span>
      </div>
      <div class="guestbook-input-wrap">
        <textarea
          id="guestbook-message"
          class="guestbook-textarea"
          placeholder="Share your impression…"
          maxlength="140"
          rows="2"
          required
          aria-label="Your message"
        ></textarea>
        <span class="guestbook-input-counter"><span id="msg-count">0</span>/140</span>
      </div>
      <button type="submit" class="guestbook-submit" aria-label="Submit your impression">
        <span class="guestbook-submit-text">Leave Impression</span>
        <svg class="guestbook-submit-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </form>

    <!-- Entries List -->
    <div id="guestbook-entries" class="guestbook-entries reveal">
      <div class="guestbook-entries-header">
        <span class="guestbook-entries-title">Impressions</span>
        <span id="guestbook-count" class="guestbook-count">0</span>
      </div>
      <div id="guestbook-list" class="guestbook-list">
        <p class="guestbook-empty">No impressions yet. Be the first to leave your mark.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .guestbook-section {
    max-width: 800px;
  }

  .guestbook-intro {
    text-align: center;
    max-width: 560px;
    margin: 0 auto var(--space-2xl);
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.7;
    font-style: italic;
  }

  /* ── Form ── */
  .guestbook-form {
    max-width: 600px;
    margin: 0 auto var(--space-3xl);
  }

  .guestbook-input-wrap {
    position: relative;
    margin-bottom: var(--space-md);
  }

  .guestbook-input,
  .guestbook-textarea {
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    padding-right: 4rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.5;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .guestbook-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .guestbook-input:focus,
  .guestbook-textarea:focus {
    outline: none;
    border-color: var(--accent-gold);
    box-shadow: 0 0 0 3px rgba(255, 213, 79, 0.1);
  }

  .guestbook-input::placeholder,
  .guestbook-textarea::placeholder {
    color: var(--text-tertiary);
    opacity: 0.7;
  }

  .guestbook-input-counter {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  .guestbook-textarea ~ .guestbook-input-counter {
    top: auto;
    bottom: var(--space-md);
    transform: none;
  }

  /* ── Submit Button ── */
  .guestbook-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-2xl);
    background: transparent;
    border: 1px solid var(--accent-gold);
    border-radius: 999px;
    color: var(--accent-gold);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .guestbook-submit:hover {
    background: rgba(255, 213, 79, 0.1);
    box-shadow: 0 0 20px rgba(255, 213, 79, 0.12);
  }

  .guestbook-submit:active {
    transform: scale(0.97);
  }

  .guestbook-submit:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 4px;
  }

  .guestbook-submit-icon {
    transition: transform 0.3s ease;
  }

  .guestbook-submit:hover .guestbook-submit-icon {
    transform: rotate(90deg);
  }

  .guestbook-submit.submitting {
    opacity: 0.6;
    pointer-events: none;
  }

  /* ── Entries ── */
  .guestbook-entries {
    max-width: 600px;
    margin: 0 auto;
  }

  .guestbook-entries-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .guestbook-entries-title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .guestbook-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    background: var(--bg-card);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-gold);
    font-variant-numeric: tabular-nums;
  }

  .guestbook-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .guestbook-empty {
    text-align: center;
    color: var(--text-tertiary);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-base);
    padding: var(--space-xl) 0;
    opacity: 0.7;
  }

  /* ── Entry Card ── */
  .guestbook-entry {
    position: relative;
    padding: var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    animation: entryFadeIn 0.5s ease-out;
  }

  @keyframes entryFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .guestbook-entry:hover {
    border-color: var(--border-accent);
    box-shadow: 0 0 20px rgba(255, 213, 79, 0.04);
  }

  /* Brushstroke accent line */
  .guestbook-entry::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--space-md);
    right: var(--space-md);
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    opacity: 0.15;
    border-radius: 1px;
  }

  .guestbook-entry-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .guestbook-entry-name {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-gold);
  }

  .guestbook-entry-name.anonymous {
    color: var(--text-tertiary);
    font-style: italic;
    font-weight: 400;
  }

  .guestbook-entry-time {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .guestbook-entry-message {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-primary);
    margin: 0;
    word-wrap: break-word;
  }

  /* Decorative brushstroke underline on last entry */
  .guestbook-entry:last-child::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent-coral), var(--accent-gold), var(--accent-violet), transparent);
    opacity: 0.2;
    border-radius: 2px;
  }

  /* ── Success Toast ── */
  .guestbook-toast {
    position: fixed;
    bottom: 6rem;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    padding: var(--space-md) var(--space-xl);
    background: var(--bg-card);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    z-index: 9999;
    transition: opacity 0.3s ease, transform 0.3s ease;
    white-space: nowrap;
  }

  .guestbook-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ── Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .guestbook-entry {
      animation: none;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .guestbook-intro {
      font-size: var(--text-base);
    }

    .guestbook-input,
    .guestbook-textarea {
      font-size: var(--text-sm);
    }

    .guestbook-submit {
      width: 100%;
      justify-content: center;
    }

    .guestbook-entry {
      padding: var(--space-md);
    }

    .guestbook-entry-message {
      font-size: var(--text-sm);
    }

    .guestbook-toast {
      bottom: 5rem;
      max-width: 90vw;
      white-space: normal;
      text-align: center;
    }
  }
</style>

<script is:inline src="/js/guestbook.js" defer></script>
