{
  "name": "van-gogh-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-content.js && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual/ --update",
    "test:visual:ci": "playwright test tests/visual/",
    "deploy": "npm run build && cp -r dist/* /data/data/com.termux/files/usr/share/nginx/html/",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@shikijs/core": "^4.0.2",
    "@shikijs/types": "^4.0.2",
    "astro": "^4",
    "shiki": "^4.0.2",
    "three": "^0.160",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^24.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~1.6.0"
  }
}
