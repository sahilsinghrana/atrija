---
// Base layout for all pages — loads Three.js scene and global styles
const { title = "Selene — A Van Gogh Experience", description = "An artistic 3D experience inspired by Van Gogh's impressionist vision. Moon, stars, sunflowers, and philosophy intertwined." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-primary: #1a237e;
      --color-secondary: #ffd54f;
      --color-accent: #4fc3f7;
      --color-bg: #0a0a1a;
      --color-text: #e8e8f0;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Inter', system-ui, sans-serif;
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      background: var(--color-bg);
      color: var(--color-text);
      min-height: 100vh;
      overflow-x: hidden;
    }
    #canvas-container {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 0;
    }
    #content {
      position: relative;
      z-index: 1;
    }
    .section {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem 2rem;
      max-width: 800px;
      margin: 0 auto;
    }
    .section h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 600;
      color: var(--color-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.1;
    }
    .section h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 600;
      color: var(--color-secondary);
      margin-bottom: 1rem;
    }
    .section p {
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 1.5rem;
      opacity: 0.9;
    }
    .fact-card {
      background: rgba(255,255,255,0.04);
      border-left: 3px solid var(--color-accent);
      padding: 1.5rem 2rem;
      margin: 2rem 0;
      border-radius: 0 8px 8px 0;
      backdrop-filter: blur(10px);
    }
    .fact-card .source {
      font-size: 0.85rem;
      color: var(--color-accent);
      margin-top: 0.75rem;
      font-style: italic;
    }
    .quote-block {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 1.4rem;
      text-align: center;
      padding: 2rem;
      color: var(--color-secondary);
      opacity: 0.85;
    }
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      background: rgba(10,10,26,0.8);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .nav .logo {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      color: var(--color-secondary);
      text-decoration: none;
      font-weight: 600;
    }
    .nav-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }
    .nav-links a {
      color: var(--color-text);
      text-decoration: none;
      font-size: 0.9rem;
      opacity: 0.7;
      transition: opacity 0.3s;
    }
    .nav-links a:hover { opacity: 1; color: var(--color-secondary); }
    .changelog-panel {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      z-index: 100;
      background: rgba(10,10,26,0.9);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 1rem;
      max-width: 320px;
      font-size: 0.8rem;
      backdrop-filter: blur(12px);
    }
    .changelog-panel h4 {
      color: var(--color-accent);
      margin-bottom: 0.5rem;
      font-size: 0.85rem;
    }
    .changelog-panel ul {
      list-style: none;
      padding: 0;
    }
    .changelog-panel li {
      padding: 0.25rem 0;
      opacity: 0.7;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .changelog-panel .date {
      color: var(--color-secondary);
      font-weight: 500;
    }
    .hero-overlay {
      position: absolute;
      bottom: 15%;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      pointer-events: none;
    }
    .hero-overlay h1 {
      font-family: var(--font-serif);
      font-size: clamp(3rem, 8vw, 6rem);
      color: var(--color-secondary);
      text-shadow: 0 0 40px rgba(255,213,79,0.3);
    }
    .hero-overlay p {
      font-size: 1.2rem;
      opacity: 0.7;
      margin-top: 0.5rem;
    }
    .scroll-indicator {
      position: absolute;
      bottom: 5%;
      left: 50%;
      transform: translateX(-50%);
      animation: bounce 2s infinite;
      opacity: 0.5;
    }
    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
      40% { transform: translateX(-50%) translateY(-10px); }
      60% { transform: translateX(-50%) translateY(-5px); }
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>
  <div id="content">
    <nav class="nav">
      <a href="#hero" class="logo">Selene</a>
      <ul class="nav-links">
        <li><a href="#moon">Moon</a></li>
        <li><a href="#philosophy">Philosophy</a></li>
        <li><a href="#gita">Gita</a></li>
        <li><a href="#shiva">Shiva</a></li>
        <li><a href="#art">Art</a></li>
        <li><a href="#changelog">Log</a></li>
      </ul>
    </nav>
    <slot />
  </div>
</body>
</html>
