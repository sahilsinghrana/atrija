---
const { title = "अत्रिज", description = "An impressionist journey through light, philosophy, and the cosmos." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/loader.css" />
  <style>
    :root {
      --bg: #08080f;
      --bg-card: rgba(255,255,255,0.03);
      --bg-card-hover: rgba(255,255,255,0.06);
      --border: rgba(255,255,255,0.08);
      --border-accent: rgba(255,213,79,0.3);
      --text: #e8e6e1;
      --text-dim: rgba(232,230,225,0.6);
      --text-muted: rgba(232,230,225,0.4);
      --gold: #ffd54f;
      --gold-dim: rgba(255,213,79,0.15);
      --blue: #4fc3f7;
      --blue-dim: rgba(79,195,247,0.12);
      --coral: #ff8a65;
      --coral-dim: rgba(255,138,101,0.12);
      --violet: #b388ff;
      --violet-dim: rgba(179,136,255,0.10);
      --sage: #80cbc4;
      --sage-dim: rgba(128,203,196,0.10);
      --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
      --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --devanagari: 'Noto Sans Devanagari', sans-serif;
      --max-w: 720px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: auto; -webkit-text-size-adjust: 100%; }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
    }

    /* ── Canvas ── */
    #canvas-container { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    main { position: relative; z-index: 1; }

    /* ── Hero ── */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem 1.5rem;
      position: relative;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 50%;
      transform: translateX(-50%);
      width: 1px; height: 60px;
      background: linear-gradient(to bottom, var(--gold), transparent);
      opacity: 0.4;
    }

    /* ── ASCII Moon (large, fixed, no label) ── */
    .ascii-moon {
      font-family: 'Courier New', 'Lucida Console', monospace;
      font-size: clamp(0.45rem, 1.8vw, 0.85rem);
      line-height: 1.1;
      color: var(--gold);
      text-shadow: 0 0 30px rgba(255,213,79,0.4), 0 0 80px rgba(255,213,79,0.15);
      white-space: pre;
      user-select: none;
      margin-bottom: 1rem;
    }

    /* ── Logo ── */
    .logo-sanskrit {
      font-family: var(--devanagari);
      font-size: clamp(3.5rem, 14vw, 8rem);
      font-weight: 700;
      line-height: 1.05;
      margin-bottom: 0.15rem;
      letter-spacing: 0.02em;
      background: linear-gradient(135deg, var(--gold) 0%, #fff8e1 40%, var(--gold) 70%, #ffe082 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200% 200%;
    }
    .logo-subtitle {
      font-family: var(--serif);
      font-size: clamp(0.7rem, 2vw, 0.95rem);
      font-style: italic;
      color: var(--text-muted);
      letter-spacing: 0.08em;
      margin-bottom: 0.5rem;
    }
    .logo-tagline {
      font-family: var(--serif);
      font-size: clamp(0.85rem, 2.8vw, 1.2rem);
      color: var(--text-dim);
      font-style: italic;
      max-width: 90vw;
    }
    .logo-tagline em { color: var(--gold); font-weight: 400; }

    .hero .scroll-hint {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      color: var(--text-muted);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      animation: fadeUp 2s ease-in-out infinite;
    }
    @keyframes fadeUp {
      0%, 100% { opacity: 0.3; transform: translateX(-50%) translateY(0); }
      50% { opacity: 0.8; transform: translateX(-50%) translateY(-8px); }
    }

    /* ── Sections ── */
    .section {
      padding: 3.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .section:last-of-type { padding-bottom: 1.5rem; }
    .section-inner { width: 100%; max-width: var(--max-w); }

    .section-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-accent);
      max-width: 60px;
    }

    /* ── Headings ── */
    .section h2 {
      font-family: var(--serif);
      font-size: clamp(1.5rem, 5.5vw, 2.6rem);
      font-weight: 600;
      line-height: 1.2;
      margin-bottom: 1.25rem;
    }
    #today h2 { color: var(--gold); }
    #today h2 em { color: var(--coral); font-style: italic; font-weight: 400; }
    #moon h2 { color: var(--blue); }
    #moon h2 em { color: var(--gold); font-style: italic; font-weight: 400; }
    #philosophy h2 { color: var(--coral); }
    #philosophy h2 em { color: var(--sage); font-style: italic; font-weight: 400; }
    #gita h2 { color: var(--violet); }
    #gita h2 em { color: var(--gold); font-style: italic; font-weight: 400; }
    #shiva h2 { color: var(--sage); }
    #shiva h2 em { color: var(--blue); font-style: italic; font-weight: 400; }
    #art h2 { color: var(--gold); }
    #art h2 em { color: var(--coral); font-style: italic; font-weight: 400; }
    #changelog h2 { color: var(--text-dim); }
    #changelog h2 em { color: var(--gold); font-style: italic; font-weight: 400; }

    .section > .section-inner > p {
      font-size: 0.95rem;
      color: var(--text-dim);
      margin-bottom: 1.25rem;
      max-width: 600px;
    }

    /* ── Image Cards with text overlay ── */
    .image-card {
      position: relative;
      width: 100%;
      margin: 1.5rem 0;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
      min-height: 200px;
    }
    .image-card .card-bg {
      position: absolute;
      inset: 0;
      background: var(--card-bg-image) center/cover no-repeat;
      opacity: 0.35;
      transition: opacity 0.4s ease;
    }
    .image-card:hover .card-bg { opacity: 0.5; }
    .image-card .card-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8,8,15,0.3) 0%, rgba(8,8,15,0.85) 60%, rgba(8,8,15,0.95) 100%);
    }
    .image-card .card-content {
      position: relative;
      z-index: 1;
      padding: 2.5rem 1.5rem 1.5rem;
    }
    .image-card .card-content p {
      font-size: 0.95rem;
      color: var(--text);
      line-height: 1.7;
      margin-bottom: 0.5rem;
    }
    .image-card .card-content .source {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-style: italic;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .image-card .card-content .source::before { content: '—'; color: var(--gold); opacity: 0.5; }

    /* ── Fact Cards ── */
    .fact-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem;
      margin: 1rem 0;
      position: relative;
      overflow: hidden;
    }
    .fact-card p { font-size: 0.9rem; color: var(--text-dim); line-height: 1.7; }
    .fact-card .source {
      margin-top: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      font-style: italic;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .fact-card .source::before { content: '—'; color: var(--gold); opacity: 0.5; }

    /* ── Quote Block ── */
    .quote-block {
      text-align: center;
      padding: 2rem 1.5rem;
      margin: 1.5rem 0;
      position: relative;
    }
    .quote-block::before {
      content: '"';
      font-family: var(--serif);
      font-size: 3.5rem;
      color: var(--gold);
      opacity: 0.2;
      position: absolute;
      top: 0.25rem;
      left: 50%;
      transform: translateX(-50%);
      line-height: 1;
    }
    .quote-block p {
      font-family: var(--serif);
      font-size: clamp(1rem, 3.5vw, 1.5rem);
      font-style: italic;
      font-weight: 400;
      color: var(--text);
      line-height: 1.5;
      position: relative;
      z-index: 1;
    }

    /* ── Today Section ── */
    .today-fact {
      background: linear-gradient(135deg, var(--gold-dim), var(--blue-dim));
      border: 1px solid var(--border-accent);
      border-radius: 12px;
      padding: 1.5rem;
      margin: 1.5rem 0;
    }
    .today-fact .theme-tag {
      display: inline-block;
      font-size: 0.7rem;
      color: var(--text-muted);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.15rem 0.5rem;
      margin-bottom: 0.75rem;
    }
    .today-fact p { font-size: 0.95rem; color: var(--text); line-height: 1.7; }
    .today-fact .source {
      margin-top: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      font-style: italic;
    }

    /* ── Changelog ── */
    .changelog-section { padding-bottom: 0; }
    .changelog-timeline { position: relative; padding-left: 1.5rem; }
    .changelog-timeline::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, var(--gold), var(--border), transparent);
    }
    .changelog-entry {
      position: relative;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .changelog-entry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .changelog-entry::before {
      content: '';
      position: absolute;
      left: -1.5rem; top: 0.4rem;
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--gold);
      border: 2px solid var(--bg);
      box-shadow: 0 0 8px rgba(255,213,79,0.3);
      transform: translateX(-4px);
    }
    .changelog-entry-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }
    .changelog-date { font-size: 0.65rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; }
    .changelog-type {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      line-height: 1.4;
    }
    .changelog-type.type-initial { background: rgba(255,213,79,0.12); color: var(--gold); border: 1px solid rgba(255,213,79,0.2); }
    .changelog-type.type-feature { background: rgba(79,195,247,0.12); color: var(--blue); border: 1px solid rgba(79,195,247,0.2); }
    .changelog-type.type-fix { background: rgba(255,138,101,0.12); color: var(--coral); border: 1px solid rgba(255,138,101,0.2); }
    .changelog-type.type-content { background: rgba(179,136,255,0.12); color: var(--violet); border: 1px solid rgba(179,136,255,0.2); }
    .changelog-type.type-design { background: rgba(128,203,196,0.12); color: var(--sage); border: 1px solid rgba(128,203,196,0.2); }
    .changelog-version {
      font-family: 'Courier New', monospace;
      font-size: 0.6rem;
      color: var(--text-muted);
      background: rgba(255,255,255,0.04);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      margin-left: auto;
    }
    .changelog-desc {
      font-family: var(--serif);
      font-size: 0.95rem;
      font-style: italic;
      color: var(--text);
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }
    .changelog-changes { list-style: none; padding: 0; margin: 0; }
    .changelog-changes li {
      font-size: 0.8rem;
      color: var(--text-dim);
      padding: 0.25rem 0 0.25rem 1.1rem;
      position: relative;
      line-height: 1.5;
    }
    .changelog-changes li::before { content: '→'; position: absolute; left: 0; color: var(--gold); opacity: 0.5; font-size: 0.7rem; }
    .changelog-changes li + li { border-top: 1px solid rgba(255,255,255,0.03); }

    /* ── Footer (minimal) ── */
    footer {
      text-align: center;
      padding: 1.5rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.7rem;
      position: relative;
      z-index: 1;
    }
    footer .footer-sanskrit {
      font-family: var(--devanagari);
      font-size: 1rem;
      color: var(--gold);
      opacity: 0.4;
      margin-bottom: 0.25rem;
    }

    /* ── Responsive ── */
    @media (min-width: 768px) {
      .hero { padding: 3rem 2rem; }
      .section { padding: 5rem 2rem; }
      .section:last-of-type { padding-bottom: 2rem; }
      .fact-card { padding: 1.5rem 1.75rem; }
      .today-fact { padding: 2rem; }
      .image-card { margin: 2rem 0; min-height: 260px; }
      .image-card .card-content { padding: 3.5rem 2rem 2rem; }
      .quote-block { padding: 2.5rem 2rem; }
      .changelog-timeline { padding-left: 2rem; }
      .changelog-entry::before { left: -2rem; }
      footer { padding: 2rem; }
    }

    @keyframes noteFloat {
      0%   { opacity: 0; transform: translateY(0) scale(0.5) rotate(0deg); }
      15%  { opacity: 1; transform: translateY(-10px) scale(1) rotate(-5deg); }
      100% { opacity: 0; transform: translateY(-120px) scale(0.7) rotate(15deg); }
    }
    @keyframes logoShimmer {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
  </style>
</head>
<body>
  <div id="loader">
    <div class="loader-ring"></div>
    <div class="loader-text">Painting the sky<span class="loader-dots"></span></div>
  </div>

  <div id="canvas-container"></div>

  <!-- Flute button: inline styles, always on top -->
  <div id="flute-container" title="Click to play" style="position:fixed;bottom:2rem;right:2rem;z-index:9999;cursor:pointer;width:64px;height:64px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,213,79,0.08);border:1px solid rgba(255,213,79,0.2);-webkit-tap-highlight-color:transparent;">
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:38px;height:38px;">
      <rect x="4" y="20" width="38" height="8" rx="4" fill="#d4a843" opacity="0.9"/>
      <rect x="4" y="21" width="38" height="3" rx="1.5" fill="#e8c060" opacity="0.4"/>
      <circle cx="12" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="19" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="26" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="33" cy="24" r="2" fill="#1a1a1a"/>
      <text x="42" y="14" font-size="14" fill="#ffd54f" opacity="0.7" font-family="serif">♪</text>
      <text x="2" y="38" font-size="10" fill="#ffd54f" opacity="0.4" font-family="serif">♫</text>
    </svg>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-sanskrit">अत्रिज</div>
    An impressionist experience in light &amp; philosophy
  </footer>

  <!-- Flute Click Handler -->
  <script>
    (function() {
      var flute = document.getElementById('flute-container');
      if (!flute) return;
      var symbols = ['♪','♫','♩','♬','♭','♮','♯'];
      var colors = ['#ffd54f','#ff8a65','#4fc3f7','#b388ff','#80cbc4','#fff'];
      flute.addEventListener('click', function(e) {
        var cx = e.clientX || window.innerWidth/2;
        var cy = e.clientY || window.innerHeight/2;
        for (var i = 0; i < 8; i++) {
          (function(idx) {
            setTimeout(function() {
              var n = document.createElement('div');
              n.textContent = symbols[Math.floor(Math.random()*symbols.length)];
              n.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;font-family:serif;font-size:' + (1.2+Math.random()*1.5) + 'rem;color:' + colors[Math.floor(Math.random()*colors.length)] + ';left:' + (cx+(Math.random()-0.5)*120) + 'px;top:' + (cy+(Math.random()-0.5)*60-40) + 'px;animation:noteFloat 2.5s ease-out forwards;';
              document.body.appendChild(n);
              setTimeout(function(){n.remove();},2600);
            }, idx*100);
          })(i);
        }
      });
    })();

    /* Scroll flowers */
    (function() {
      var positions = [
        {x:'3%',y:'35%',color:'#f5c800'},
        {x:'90%',y:'50%',color:'#ff6699'},
        {x:'6%',y:'72%',color:'#cc2242'}
      ];
      var flowers = [], revealed = new Set(), ticking = false;
      positions.forEach(function(pos, i) {
        var el = document.createElement('div');
        el.style.cssText = 'position:fixed;z-index:40;pointer-events:none;opacity:0;transform:scale(0) rotate(-30deg);transition:opacity 0.6s ease,transform 0.6s cubic-bezier(0.34,1.56,0.64,1);left:'+pos.x+';top:'+pos.y+';';
        el.innerHTML = '<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="width:36px;height:36px"><circle cx="20" cy="20" r="6" fill="'+pos.color+'" opacity="0.8"/><g fill="'+pos.color+'" opacity="0.7">';
        for (var p = 0; p < 8; p++) {
          var a = (p/8)*Math.PI*2, px = 20+Math.cos(a)*10, py = 20+Math.sin(a)*10;
          el.innerHTML += '<ellipse cx="'+px+'" cy="'+py+'" rx="4" ry="7" transform="rotate('+(a*180/Math.PI)+','+px+','+py+')"/>';
        }
        el.innerHTML += '</g></svg>';
        document.body.appendChild(el);
        flowers.push({el:el, triggerY:(i+1)*600+500});
      });
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            var sy = window.scrollY;
            flowers.forEach(function(f, idx) {
              if (!revealed.has(idx) && sy > f.triggerY) {
                f.el.style.opacity = '1';
                f.el.style.transform = 'scale(1) rotate(0deg)';
                revealed.add(idx);
              }
            });
            ticking = false;
          });
          ticking = true;
        }
      }, {passive:true});
    })();
  </script>
</body>
</html>
