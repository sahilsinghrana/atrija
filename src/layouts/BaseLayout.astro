---
const { title = "Selene", description = "An impressionist journey through light, philosophy, and the cosmos." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/loader.css" />
  <style>

    :root {
      --bg: #08080f;
      --bg-card: rgba(255,255,255,0.03);
      --bg-card-hover: rgba(255,255,255,0.06);
      --border: rgba(255,255,255,0.08);
      --border-accent: rgba(255,213,79,0.3);
      --text: #e8e6e1;
      --text-dim: rgba(232,230,225,0.6);
      --text-muted: rgba(232,230,225,0.4);
      --gold: #ffd54f;
      --gold-dim: rgba(255,213,79,0.15);
      --blue: #4fc3f7;
      --blue-dim: rgba(79,195,247,0.12);
      --coral: #ff8a65;
      --coral-dim: rgba(255,138,101,0.12);
      --violet: #b388ff;
      --violet-dim: rgba(179,136,255,0.10);
      --sage: #80cbc4;
      --sage-dim: rgba(128,203,196,0.10);
      --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
      --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --max-w: 720px;
      --nav-h: 60px;
    }

    html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ── Canvas Background ── */
    #canvas-container {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    /* ── Twinkling Stars Overlay (CSS layer) ── */
    #stars-overlay {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .twinkle-star {
      position: absolute;
      border-radius: 50%;
      background: #fff;
      animation: twinkle var(--dur, 3s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }
    @keyframes twinkle {
      0%, 100% { opacity: var(--min-op, 0.15); transform: scale(1); }
      50% { opacity: var(--max-op, 0.8); transform: scale(1.3); }
    }

    /* ── Revolving Moon (CSS) ── */
    #moon-revolver {
      position: fixed;
      top: 8%;
      right: 10%;
      z-index: 0;
      pointer-events: none;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #fff8e7, #ffe082 60%, rgba(255,213,79,0.3));
      box-shadow: 0 0 40px 15px rgba(255,213,79,0.12), 0 0 80px 30px rgba(255,213,79,0.06);
      animation: moonRevolve 120s linear infinite;
    }
    @keyframes moonRevolve {
      0%   { transform: rotate(0deg) translateX(20px) rotate(0deg); opacity: 0.7; }
      50%  { transform: rotate(180deg) translateX(20px) rotate(-180deg); opacity: 0.9; }
      100% { transform: rotate(360deg) translateX(20px) rotate(-360deg); opacity: 0.7; }
    }

    /* ── Navigation ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      height: var(--nav-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      background: rgba(8,8,15,0.85);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      border-bottom: 1px solid var(--border);
    }
    nav .logo {
      font-family: var(--serif);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--gold);
      text-decoration: none;
      letter-spacing: 0.02em;
    }
    nav .logo span { font-weight: 400; opacity: 0.6; }
    .nav-links { display: flex; gap: 0; list-style: none; }
    .nav-links a {
      display: block;
      padding: 0.5rem 1rem;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }
    .nav-links a:hover { color: var(--gold); background: var(--gold-dim); }

    /* ── Main Content ── */
    main {
      position: relative;
      z-index: 1;
      padding-top: var(--nav-h);
    }

    /* ── Hero ── */
    .hero {
      min-height: calc(100vh - var(--nav-h));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 3rem 2rem;
      position: relative;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 50%;
      transform: translateX(-50%);
      width: 1px; height: 80px;
      background: linear-gradient(to bottom, var(--gold), transparent);
      opacity: 0.4;
    }
    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(3.5rem, 10vw, 7rem);
      font-weight: 700;
      color: var(--text);
      line-height: 1;
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }
    .hero h1 em {
      font-style: italic;
      font-weight: 400;
      color: var(--gold);
      text-shadow: 0 0 40px rgba(255,213,79,0.2);
    }
    .hero p {
      font-family: var(--serif);
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--text-dim);
      font-style: italic;
      max-width: 500px;
    }
    .hero .scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      color: var(--text-muted);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      animation: fadeUp 2s ease-in-out infinite;
    }
    @keyframes fadeUp {
      0%, 100% { opacity: 0.3; transform: translateX(-50%) translateY(0); }
      50% { opacity: 0.8; transform: translateX(-50%) translateY(-8px); }
    }

    /* ── Section Base ── */
    .section {
      padding: 6rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .section-inner {
      width: 100%;
      max-width: var(--max-w);
    }
    .section-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-accent);
      max-width: 60px;
    }

    /* ── Color Theory Typography ── */
    .section h2 {
      font-family: var(--serif);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 600;
      line-height: 1.15;
      margin-bottom: 2rem;
    }
    /* Section-specific heading color theming via color theory */
    #today h2 { color: var(--gold); }
    #today h2 em { color: var(--coral); font-style: italic; font-weight: 400; }

    #moon h2 { color: var(--blue); }
    #moon h2 em { color: var(--gold); font-style: italic; font-weight: 400; text-shadow: 0 0 30px rgba(255,213,79,0.15); }

    #philosophy h2 { color: var(--coral); }
    #philosophy h2 em { color: var(--sage); font-style: italic; font-weight: 400; }

    #gita h2 { color: var(--violet); }
    #gita h2 em { color: var(--gold); font-style: italic; font-weight: 400; }

    #shiva h2 { color: var(--sage); }
    #shiva h2 em { color: var(--blue); font-style: italic; font-weight: 400; }

    #art h2 { color: var(--gold); }
    #art h2 em { color: var(--coral); font-style: italic; font-weight: 400; }

    #changelog h2 { color: var(--text-dim); }
    #changelog h2 em { color: var(--gold); font-style: italic; font-weight: 400; }

    .section > .section-inner > p {
      font-size: 1.05rem;
      color: var(--text-dim);
      margin-bottom: 1.5rem;
      max-width: 600px;
    }

    /* ── Image Cards ── */
    .image-card {
      position: relative;
      width: 100%;
      margin: 2.5rem 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .image-card img, .image-card svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .image-card .image-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(8,8,15,0.7) 0%, transparent 40%);
      pointer-events: none;
    }

    /* ── Fact Cards with Image Backgrounds ── */
    .fact-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem 1.75rem;
      margin: 1.25rem 0;
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
      position: relative;
      overflow: hidden;
    }
    .fact-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--card-bg-image) center/cover no-repeat;
      opacity: 0;
      transition: opacity 0.5s ease;
      z-index: 0;
    }
    .fact-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(8,8,15,0.88), rgba(8,8,15,0.75));
      opacity: 0;
      transition: opacity 0.5s ease;
      z-index: 0;
    }
    .fact-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(255,255,255,0.12);
      transform: translateY(-2px);
    }
    .fact-card:hover::before { opacity: 1; }
    .fact-card:hover::after { opacity: 1; }
    .fact-card p, .fact-card .source {
      position: relative;
      z-index: 1;
    }
    .fact-card p {
      font-size: 0.95rem;
      color: var(--text-dim);
      line-height: 1.7;
      transition: color 0.3s;
    }
    .fact-card:hover p { color: var(--text); }
    .fact-card .source {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      font-style: italic;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .fact-card .source::before {
      content: '—';
      color: var(--gold);
      opacity: 0.5;
    }

    /* ── Quote Block ── */
    .quote-block {
      text-align: center;
      padding: 2.5rem 2rem;
      margin: 2rem 0;
      position: relative;
    }
    .quote-block::before {
      content: '"';
      font-family: var(--serif);
      font-size: 4rem;
      color: var(--gold);
      opacity: 0.2;
      position: absolute;
      top: 0.5rem;
      left: 50%;
      transform: translateX(-50%);
      line-height: 1;
    }
    .quote-block p {
      font-family: var(--serif);
      font-size: clamp(1.2rem, 3vw, 1.6rem);
      font-style: italic;
      font-weight: 400;
      color: var(--text);
      line-height: 1.5;
      position: relative;
      z-index: 1;
    }

    /* ── Today Section ── */
    .today-fact {
      background: linear-gradient(135deg, var(--gold-dim), var(--blue-dim));
      border: 1px solid var(--border-accent);
      border-radius: 12px;
      padding: 2rem;
      margin: 2rem 0;
    }
    .today-fact .label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
    }
    .today-fact .theme-tag {
      display: inline-block;
      font-size: 0.75rem;
      color: var(--text-muted);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.2rem 0.6rem;
      margin-bottom: 1rem;
    }
    .today-fact p {
      font-size: 1rem;
      color: var(--text);
      line-height: 1.7;
    }
    .today-fact .source {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      font-style: italic;
    }

    /* ── Changelog ── */
    .changelog-section { padding-bottom: 4rem; }
    .changelog-entry {
      border-left: 2px solid var(--border);
      padding-left: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .changelog-entry .date {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--gold);
      margin-bottom: 0.25rem;
    }
    .changelog-entry .desc {
      font-size: 0.9rem;
      color: var(--text-dim);
      margin-bottom: 0.5rem;
    }
    .changelog-entry ul {
      list-style: none;
      padding: 0;
    }
    .changelog-entry li {
      font-size: 0.8rem;
      color: var(--text-muted);
      padding: 0.15rem 0;
      padding-left: 1rem;
      position: relative;
    }
    .changelog-entry li::before {
      content: '·';
      position: absolute;
      left: 0;
      color: var(--gold);
      opacity: 0.5;
    }

    /* ── Interactive Flute ── */
    #flute-container {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 50;
      cursor: pointer;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(255,213,79,0.06);
      border: 1px solid rgba(255,213,79,0.15);
      transition: background 0.3s, border-color 0.3s, transform 0.2s;
    }
    #flute-container:hover {
      background: rgba(255,213,79,0.12);
      border-color: rgba(255,213,79,0.35);
      transform: scale(1.08);
    }
    #flute-container svg {
      width: 48px;
      height: 48px;
    }
    #flute-container .flute-tooltip {
      position: absolute;
      bottom: 100%;
      right: 0;
      margin-bottom: 8px;
      font-size: 0.7rem;
      color: var(--text-muted);
      white-space: nowrap;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    #flute-container:hover .flute-tooltip { opacity: 1; }

    /* ── Music Notes (spawned by flute click) ── */
    .spawned-note {
      position: fixed;
      z-index: 60;
      pointer-events: none;
      font-family: serif;
      font-size: 1.5rem;
      color: var(--gold);
      animation: noteFloat 2.5s ease-out forwards;
      text-shadow: 0 0 10px rgba(255,213,79,0.4);
    }
    @keyframes noteFloat {
      0%   { opacity: 0; transform: translateY(0) scale(0.5) rotate(0deg); }
      15%  { opacity: 1; transform: translateY(-10px) scale(1) rotate(-5deg); }
      100% { opacity: 0; transform: translateY(-120px) scale(0.7) rotate(15deg); }
    }

    /* ── Scroll-triggered Flowers ── */
    .scroll-flower {
      position: fixed;
      z-index: 40;
      pointer-events: none;
      opacity: 0;
      transform: scale(0) rotate(-30deg);
      transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .scroll-flower.visible {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
    .scroll-flower svg {
      width: 40px;
      height: 40px;
      filter: drop-shadow(0 0 6px rgba(255,213,79,0.3));
    }

    /* ── Footer ── */
    footer {
      text-align: center;
      padding: 3rem 2rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.8rem;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .nav-links { gap: 0; }
      .nav-links a { padding: 0.4rem 0.7rem; font-size: 0.75rem; }
      .section { padding: 4rem 1.25rem; }
      .hero { padding: 2rem 1.25rem; }
      .hero h1 { font-size: clamp(2.5rem, 12vw, 4.5rem); }
      .fact-card { padding: 1.25rem; }
      .today-fact { padding: 1.5rem; }
      .image-card { margin: 1.5rem 0; border-radius: 8px; }
      #flute-container { bottom: 1rem; right: 1rem; width: 60px; height: 60px; }
      #flute-container svg { width: 36px; height: 36px; }
      #moon-revolver { width: 40px; height: 40px; top: 12%; }
    }
    @media (max-width: 480px) {
      nav { padding: 0 1rem; }
      .nav-links { display: none; }
      .section { padding: 3rem 1rem; }
      .quote-block { padding: 1.5rem 1rem; }
      .quote-block::before { font-size: 3rem; }
      #moon-revolver { display: none; }
    }
  </style>
</head>
<body>
  <div id="loader">
    <div class="loader-ring"></div>
    <div class="loader-text">Painting the sky<span class="loader-dots"></span></div>
  </div>

  <div id="canvas-container"></div>

  <!-- CSS Twinkling Stars Overlay -->
  <div id="stars-overlay"></div>

  <!-- CSS Revolving Moon -->
  <div id="moon-revolver"></div>

  <!-- Interactive Flute Button -->
  <div id="flute-container" title="Click to play">
    <span class="flute-tooltip">Click to play</span>
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="20" width="38" height="8" rx="4" fill="#d4a843" opacity="0.9"/>
      <rect x="4" y="21" width="38" height="3" rx="1.5" fill="#e8c060" opacity="0.4"/>
      <circle cx="12" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="19" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="26" cy="24" r="2" fill="#1a1a1a"/>
      <circle cx="33" cy="24" r="2" fill="#1a1a1a"/>
      <text x="42" y="14" font-size="14" fill="#ffd54f" opacity="0.7" font-family="serif">♪</text>
      <text x="2" y="38" font-size="10" fill="#ffd54f" opacity="0.4" font-family="serif">♫</text>
    </svg>
  </div>

  <nav>
    <a href="#hero" class="logo">Selene<span>.</span></a>
    <ul class="nav-links">
      <li><a href="#today">Today</a></li>
      <li><a href="#moon">Moon</a></li>
      <li><a href="#philosophy">Philosophy</a></li>
      <li><a href="#gita">Gita</a></li>
      <li><a href="#shiva">Shiva</a></li>
      <li><a href="#art">Art</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    Selene — An impressionist experience in light &amp; philosophy
  </footer>

  <!-- Interactive Scripts -->
  <script>
    // ── Twinkling Stars Generator ──
    (function() {
      var overlay = document.getElementById('stars-overlay');
      if (!overlay) return;
      var count = 80;
      for (var i = 0; i < count; i++) {
        var star = document.createElement('div');
        star.className = 'twinkle-star';
        var size = 1 + Math.random() * 2.5;
        star.style.cssText = 'width:' + size + 'px;height:' + size + 'px;' +
          'left:' + (Math.random() * 100) + '%;' +
          'top:' + (Math.random() * 100) + '%;' +
          '--dur:' + (2 + Math.random() * 4) + 's;' +
          '--delay:' + (Math.random() * 5) + 's;' +
          '--min-op:' + (0.1 + Math.random() * 0.2) + ';' +
          '--max-op:' + (0.5 + Math.random() * 0.5) + ';';
        overlay.appendChild(star);
      }
    })();

    // ── Flute Click → Music Notes ──
    (function() {
      var flute = document.getElementById('flute-container');
      if (!flute) return;
      var noteSymbols = ['♪', '♫', '♩', '♬', '♭', '♮', '♯'];
      var colors = ['#ffd54f', '#ff8a65', '#4fc3f7', '#b388ff', '#80cbc4', '#fff'];
      flute.addEventListener('click', function(e) {
        for (var i = 0; i < 8; i++) {
          (function(idx) {
            setTimeout(function() {
              var note = document.createElement('div');
              note.className = 'spawned-note';
              note.textContent = noteSymbols[Math.floor(Math.random() * noteSymbols.length)];
              note.style.color = colors[Math.floor(Math.random() * colors.length)];
              note.style.left = (e.clientX + (Math.random() - 0.5) * 100) + 'px';
              note.style.top = (e.clientY + (Math.random() - 0.5) * 40) + 'px';
              note.style.fontSize = (1 + Math.random() * 1.5) + 'rem';
              document.body.appendChild(note);
              setTimeout(function() { note.remove(); }, 2500);
            }, idx * 120);
          })(i);
        }
      });
    })();

    // ── Scroll-triggered Flowers ──
    (function() {
      var flowerPositions = [
        { x: '5%', y: '25%', color: '#f5c800' },
        { x: '88%', y: '35%', color: '#ff6699' },
        { x: '12%', y: '55%', color: '#cc2242' },
        { x: '82%', y: '65%', color: '#ffcc00' },
        { x: '8%', y: '80%', color: '#9933cc' },
        { x: '90%', y: '85%', color: '#ff4400' }
      ];
      var flowers = [];
      flowerPositions.forEach(function(pos, i) {
        var el = document.createElement('div');
        el.className = 'scroll-flower';
        el.style.left = pos.x;
        el.style.top = pos.y;
        el.innerHTML = '<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">' +
          '<circle cx="20" cy="20" r="6" fill="' + pos.color + '" opacity="0.8"/>' +
          '<g fill="' + pos.color + '" opacity="0.7">';
        for (var p = 0; p < 8; p++) {
          var angle = (p / 8) * Math.PI * 2;
          var px = 20 + Math.cos(angle) * 10;
          var py = 20 + Math.sin(angle) * 10;
          el.innerHTML += '<ellipse cx="' + px + '" cy="' + py + '" rx="4" ry="7" transform="rotate(' + (angle * 180 / Math.PI) + ',' + px + ',' + py + ')"/>';
        }
        el.innerHTML += '</g></svg>';
        document.body.appendChild(el);
        flowers.push({ el: el, triggerY: (i + 1) * 300 + 200 });
      });

      var revealed = new Set();
      window.addEventListener('scroll', function() {
        var scrollY = window.scrollY;
        flowers.forEach(function(f, idx) {
          if (!revealed.has(idx) && scrollY > f.triggerY) {
            f.el.classList.add('visible');
            revealed.add(idx);
          }
        });
      });
    })();
  </script>
</body>
</html>
