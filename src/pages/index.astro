---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../content/siteData.json';
import content from '../content/content.json';

const now = new Date();
const start = new Date(now.getFullYear(), 0, 0);
const diff = now.getTime() - start.getTime();
const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));

const todayThemeIndex = (dayOfYear + 2) % siteData.themes.length;
const colorIndex = dayOfYear % siteData.colorSchemes.length;
const todayTheme = siteData.themes[todayThemeIndex];
const todayColor = siteData.colorSchemes[colorIndex];
const todayFact = todayTheme.facts[dayOfYear % todayTheme.facts.length];
const todayQuote = todayTheme.quotes[dayOfYear % todayTheme.quotes.length];

// Use content.json changelog for version only — entries loaded client-side from /changelog/
const changelogSource = content.changelog || siteData.changelog;
const changelogVersion = changelogSource.version;

// Section text from content.json — edit this file to update all text content
const sec = content.sections;

const colorData = JSON.stringify({
  primary: todayColor.primary,
  secondary: todayColor.secondary,
  accent: todayColor.accent,
  background: todayColor.background,
  text: todayColor.text,
  shader: todayColor.shaderParams
});
---

<BaseLayout>

  <!-- ═══════════════════════════════════════
       AI AGENT BANNER
  ═══════════════════════════════════════ -->
  <div class="ai-banner" role="note" aria-label="Site information">
    <span class="ai-banner-icon">⚡</span>
    <span class="ai-banner-text">
      Content updates <strong>daily</strong> — this site is self-improved, built &amp; deployed by an
      <strong>AI agent</strong>, served from an <strong>Android mobile phone</strong> server.
    </span>
    <span class="ai-banner-pulse"></span>
  </div>

  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section id="hero" class="hero">
    <div id="moonContainer">
      <div id="moonShadow"></div>
      <pre id="asciiMoon"></pre>
    </div>
    <div class="hero-title-wrap">
      <div class="logo-sanskrit">अत्रिज</div>
    </div>
    <div class="logo-subtitle reveal">Atrij</div>
    <p class="logo-tagline reveal" set:html={sec.hero.tagline}></p>
    <span class="click-hint">Click anywhere to see flute magic</span>
    <span class="scroll-hint">Scroll to explore</span>
  </section>

  <!-- ═══════════════════════════════════════
       TODAY'S REFLECTION
  ═══════════════════════════════════════ -->
  <section id="today" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">Today's Reflection</div>
      <h2 class="reveal" set:html={sec.today.heading}></h2>
      <div class="today-fact reveal-scale">
        <div class="theme-tag">{todayTheme.title} · {todayColor.mood}</div>
        <p>{todayFact.text}</p>
        <div class="source">{todayFact.source}</div>
      </div>
      <div class="quote-block reveal">
        <p>{todayQuote}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       I. THE MOON — SELENE
  ═══════════════════════════════════════ -->
  <section id="moon" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">{sec.moon.label}</div>
      <h2 class="reveal" set:html={sec.moon.heading}></h2>
      <p class="reveal">{sec.moon.intro}</p>
      <div class="image-card reveal-scale" style="--card-bg-image: url('/images/moon.svg')">
        <div class="card-bg"></div>
        <div class="card-content">
          <p>{siteData.themes[sec.moon.imageCard.themeIndex].facts[sec.moon.imageCard.factIndex].text}</p>
          <div class="source">{siteData.themes[sec.moon.imageCard.themeIndex].facts[sec.moon.imageCard.factIndex].source}</div>
        </div>
      </div>
      <div class="fact-card reveal">
        <p>{siteData.themes[sec.moon.imageCard.themeIndex].facts[sec.moon.imageCard.factIndex].text}</p>
        <div class="source">{siteData.themes[sec.moon.imageCard.themeIndex].facts[sec.moon.imageCard.factIndex].source}</div>
      </div>
      <div class="quote-carousel reveal" data-theme-index={sec.moon.quote.themeIndex}>
        <div class="quote-carousel-inner">
          {siteData.themes[sec.moon.quote.themeIndex].quotes.map((q: any, i: number) => (
            <div class="quote-card" data-index={i} style={i === 0 ? '' : 'display:none'}>
              <div class="quote-block">
                <p>{q}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="quote-dots">
          {siteData.themes[sec.moon.quote.themeIndex].quotes.map((_q: any, i: number) => (
            <button class={'quote-dot' + (i === 0 ? ' active' : '')} data-index={i} aria-label={'Quote ' + (i + 1)} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       II. THE WAVES — EGO & ARROGANCE
  ═══════════════════════════════════════ -->
  <section id="philosophy" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">{sec.philosophy.label}</div>
      <h2 class="reveal" set:html={sec.philosophy.heading}></h2>
      <p class="reveal">{sec.philosophy.intro}</p>
      <div class="image-card reveal-scale" style="--card-bg-image: url('/images/waves.svg')">
        <div class="card-bg"></div>
        <div class="card-content">
          <p>{siteData.themes[sec.philosophy.imageCard.themeIndex].facts[sec.philosophy.imageCard.factIndex].text}</p>
          <div class="source">{siteData.themes[sec.philosophy.imageCard.themeIndex].facts[sec.philosophy.imageCard.factIndex].source}</div>
        </div>
      </div>
      <div class="fact-card reveal">
        <p>{siteData.themes[sec.philosophy.imageCard.themeIndex].facts[sec.philosophy.imageCard.factIndex].text}</p>
        <div class="source">{siteData.themes[sec.philosophy.imageCard.themeIndex].facts[sec.philosophy.imageCard.factIndex].source}</div>
      </div>
      <div class="quote-carousel reveal" data-theme-index={sec.philosophy.quote.themeIndex}>
        <div class="quote-carousel-inner">
          {siteData.themes[sec.philosophy.quote.themeIndex].quotes.map((q: any, i: number) => (
            <div class="quote-card" data-index={i} style={i === 0 ? '' : 'display:none'}>
              <div class="quote-block">
                <p>{q}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="quote-dots">
          {siteData.themes[sec.philosophy.quote.themeIndex].quotes.map((_q: any, i: number) => (
            <button class={'quote-dot' + (i === 0 ? ' active' : '')} data-index={i} aria-label={'Quote ' + (i + 1)} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       III. THE BATTLEFIELD — BHAGAVAD GITA
  ═══════════════════════════════════════ -->
  <section id="gita" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">{sec.gita.label}</div>
      <h2 class="reveal" set:html={sec.gita.heading}></h2>
      <p class="reveal">{sec.gita.intro}</p>
      <div class="image-card reveal-scale" style="--card-bg-image: url('/images/stars.svg')">
        <div class="card-bg"></div>
        <div class="card-content">
          <p>{siteData.themes[sec.gita.imageCard.themeIndex].facts[sec.gita.imageCard.factIndex].text}</p>
          <div class="source">{siteData.themes[sec.gita.imageCard.themeIndex].facts[sec.gita.imageCard.factIndex].source}</div>
        </div>
      </div>
      <div class="fact-card reveal">
        <p>{siteData.themes[sec.gita.imageCard.themeIndex].facts[sec.gita.imageCard.factIndex].text}</p>
        <div class="source">{siteData.themes[sec.gita.imageCard.themeIndex].facts[sec.gita.imageCard.factIndex].source}</div>
      </div>
      <div class="quote-carousel reveal" data-theme-index={sec.gita.quote.themeIndex}>
        <div class="quote-carousel-inner">
          {siteData.themes[sec.gita.quote.themeIndex].quotes.map((q: any, i: number) => (
            <div class="quote-card" data-index={i} style={i === 0 ? '' : 'display:none'}>
              <div class="quote-block">
                <p>{q}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="quote-dots">
          {siteData.themes[sec.gita.quote.themeIndex].quotes.map((_q: any, i: number) => (
            <button class={'quote-dot' + (i === 0 ? ' active' : '')} data-index={i} aria-label={'Quote ' + (i + 1)} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       IV. THE DANCE — SHIV PURANA
  ═══════════════════════════════════════ -->
  <section id="shiva" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">{sec.shiva.label}</div>
      <h2 class="reveal" set:html={sec.shiva.heading}></h2>
      <p class="reveal">{sec.shiva.intro}</p>
      <div class="image-card reveal-scale" style="--card-bg-image: url('/images/flute.svg')">
        <div class="card-bg"></div>
        <div class="card-content">
          <p>{siteData.themes[sec.shiva.imageCard.themeIndex].facts[sec.shiva.imageCard.factIndex].text}</p>
          <div class="source">{siteData.themes[sec.shiva.imageCard.themeIndex].facts[sec.shiva.imageCard.factIndex].source}</div>
        </div>
      </div>
      <div class="fact-card reveal">
        <p>{siteData.themes[sec.shiva.imageCard.themeIndex].facts[sec.shiva.imageCard.factIndex].text}</p>
        <div class="source">{siteData.themes[sec.shiva.imageCard.themeIndex].facts[sec.shiva.imageCard.factIndex].source}</div>
      </div>
      <div class="quote-block reveal">
        <p>{siteData.themes[sec.shiva.quote.themeIndex].quotes[sec.shiva.quote.quoteIndex]}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       V. THE CANVAS — ART & BEAUTY
  ═══════════════════════════════════════ -->
  <section id="art" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">{sec.art.label}</div>
      <h2 class="reveal" set:html={sec.art.heading}></h2>
      <p class="reveal">{sec.art.intro}</p>
      <div class="image-card reveal-scale" style="--card-bg-image: url('/images/sunflowers.svg')">
        <div class="card-bg"></div>
        <div class="card-content">
          <p>{siteData.themes[sec.art.imageCard.themeIndex].facts[sec.art.imageCard.factIndex].text}</p>
          <div class="source">{siteData.themes[sec.art.imageCard.themeIndex].facts[sec.art.imageCard.factIndex].source}</div>
        </div>
      </div>
      <div class="fact-card reveal">
        <p>{siteData.themes[sec.art.imageCard.themeIndex].facts[sec.art.imageCard.factIndex].text}</p>
        <div class="source">{siteData.themes[sec.art.imageCard.themeIndex].facts[sec.art.imageCard.factIndex].source}</div>
      </div>
      <div class="quote-block reveal">
        <p>{siteData.themes[sec.art.quote.themeIndex].quotes[sec.art.quote.quoteIndex]}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CHANGELOG
  ═══════════════════════════════════════ -->
  <section id="changelog" class="section">
    <div class="section-inner changelog-section">
      <div class="section-label">Changelog</div>
      <h2>Daily <em>mutations</em></h2>
      <p class="changelog-version-line">
        Version {changelogVersion} — color, content &amp; form evolve daily.
      </p>
      <div id="changelog-app" class="changelog-app">
        <div class="changelog-loading">Loading…</div>
      </div>
    </div>
  </section>

  <script type="module" src="/js/changelog-app.js"></script>

  <!-- ═══════════════════════════════════════
       THREE.JS SCENE INIT
  ═══════════════════════════════════════ -->
  <div id="vg-data" data-colors={colorData} hidden></div>
  <script>
    (function() {
      var el = document.getElementById('vg-data');
      var c = JSON.parse(el.dataset.colors);
      var r = document.documentElement.style;
      r.setProperty('--color-primary', c.primary);
      r.setProperty('--color-secondary', c.secondary);
      r.setProperty('--color-accent', c.accent);
      r.setProperty('--color-bg', c.background);
      r.setProperty('--color-text', c.text);
    })();
  </script>
  <script type="module" src="/js/scene-init.js?v=BUILD_VERSION"></script>



  <script type="module" src="/js/moon-phase.js"></script>

</BaseLayout>
