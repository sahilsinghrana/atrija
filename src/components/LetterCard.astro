---
// Letters section — placeholder data (feature removed from kanban)
const lettersData = { letters: [] };

const now = new Date();
const start = new Date(now.getFullYear(), 0, 0);
const diff = now.getTime() - start.getTime();
const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));

const letter = lettersData.letters[dayOfYear % Math.max(lettersData.letters.length, 1)];
---

<section id="letters" class="section" style="display:none">
  <div class="section-inner">
    <div class="section-label reveal-left">VII. Letters from the Artist</div>
    <h2 class="reveal">Words from the <em>Artist</em></h2>
  </div>
</section>
