---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../content/siteData.json";
import content from "../content/content.json";
import LetterCard from "../components/LetterCard.astro";
import KoanCard from "../components/KoanCard.astro";

const now = new Date();
const start = new Date(now.getFullYear(), 0, 0);
const diff = now.getTime() - start.getTime();
const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));

const todayThemeIndex = (dayOfYear + 2) % siteData.themes.length;
const colorIndex = dayOfYear % siteData.colorSchemes.length;
const todayTheme = siteData.themes[todayThemeIndex];
const todayColor = siteData.colorSchemes[colorIndex];
const todayFact = todayTheme.facts[dayOfYear % todayTheme.facts.length];
const todayQuote = todayTheme.quotes[dayOfYear % todayTheme.quotes.length];

const changelogSource = content.changelog || siteData.changelog;
const changelogVersion = changelogSource.version;
const sec = content.sections;

const colorData = JSON.stringify({
  primary: todayColor.primary,
  secondary: todayColor.secondary,
  accent: todayColor.accent,
  background: todayColor.background,
  text: todayColor.text,
  shader: todayColor.shaderParams,
});

// Section configuration — data-driven generation
const sections = [
  { id: "moon", key: "moon", image: "/images/moon.svg", carousel: true },
  { id: "shiva", key: "shiva", image: "/images/flute.svg", carousel: false },
  { id: "art", key: "art", image: "/images/sunflowers.svg", carousel: false },
  { id: "philosophy", key: "philosophy", image: "/images/waves.svg", carousel: true },
];

---
<BaseLayout>
<body>
  <div id="loader">
    <div class="loader-ring"></div>
    <div class="loader-text">Painting the sky<span class="loader-dots"></span></div>
    <div class="loader-progress"><div class="loader-progress-bar" id="loader-progress-bar"></div></div>
  </div>

  <div id="canvas-container" style="position:fixed;inset:0;z-index:0;pointer-events:none"></div>

  <!-- Flute button -->
  <div id="flute-container" title="Click to play Krishna's bansuri" style="position:fixed;bottom:2rem;right:2rem;z-index:9999;cursor:pointer;width:72px;height:72px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,213,79,0.08);border:1px solid rgba(255,213,79,0.2);-webkit-tap-highlight-color:transparent;transition:all 0.3s ease;" onmouseenter="this.style.background='rgba(255,213,79,0.15)';this.style.borderColor='rgba(255,213,79,0.4)';this.style.transform='scale(1.08)'" onmouseleave="this.style.background='rgba(255,213,79,0.08)';this.style.borderColor='rgba(255,213,79,0.2)';this.style.transform='scale(1)'">
    <svg viewBox="0 0 180 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:56px;height:auto;">
      <defs>
        <linearGradient id="bambooGradBtn" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" style="stop-color:#d4a843;stop-opacity:1" />
          <stop offset="45%" style="stop-color:#c49833;stop-opacity:1" />
          <stop offset="55%" style="stop-color:#b88820;stop-opacity:1" />
          <stop offset="100%" style="stop-color:#a67810;stop-opacity:1" />
        </linearGradient>
        <linearGradient id="highlightGradBtn" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" style="stop-color:#f5d870;stop-opacity:0.8" />
          <stop offset="100%" style="stop-color:#e8c060;stop-opacity:0.3" />
        </linearGradient>
      </defs>
      <rect x="8" y="18" width="164" height="12" rx="6" fill="url(#bambooGradBtn)"/>
      <rect x="8" y="19" width="164" height="4" rx="2" fill="url(#highlightGradBtn)" opacity="0.6"/>
      <rect x="28" y="17" width="2.5" height="14" rx="1" fill="#8a6820" opacity="0.7"/>
      <rect x="58" y="17" width="2.5" height="14" rx="1" fill="#8a6820" opacity="0.7"/>
      <rect x="88" y="17" width="2.5" height="14" rx="1" fill="#8a6820" opacity="0.7"/>
      <rect x="118" y="17" width="2.5" height="14" rx="1" fill="#8a6820" opacity="0.7"/>
      <rect x="148" y="17" width="2.5" height="14" rx="1" fill="#8a6820" opacity="0.7"/>
      <ellipse cx="45" cy="24" rx="3" ry="3.5" fill="#1a1a1a" opacity="0.9"/>
      <ellipse cx="65" cy="24" rx="3" ry="3.5" fill="#1a1a1a" opacity="0.9"/>
      <ellipse cx="85" cy="24" rx="3" ry="3.5" fill="#1a1a1a" opacity="0.9"/>
      <ellipse cx="105" cy="24" rx="3" ry="3.5" fill="#1a1a1a" opacity="0.9"/>
      <ellipse cx="125" cy="24" rx="3" ry="3.5" fill="#1a1a1a" opacity="0.9"/>
      <ellipse cx="145" cy="24" rx="3" ry="3.5" fill="#1a1a1a" opacity="0.9"/>
      <ellipse cx="95" cy="20" rx="2" ry="2.5" fill="#2a2a2a" opacity="0.6"/>
      <ellipse cx="14" cy="24" rx="4" ry="5" fill="#1a1a1a" opacity="0.85"/>
      <ellipse cx="14" cy="24" rx="2.5" ry="3.5" fill="#3a2a1a" opacity="0.5"/>
      <rect x="20" y="20" width="1" height="8" fill="#cc2244" opacity="0.8"/>
      <rect x="22" y="20" width="1" height="8" fill="#cc2244" opacity="0.8"/>
      <rect x="24" y="20" width="1" height="8" fill="#cc2244" opacity="0.8"/>
      <circle cx="168" cy="24" r="5" fill="#8a6820" opacity="0.8"/>
      <circle cx="168" cy="24" r="3" fill="#d4a843" opacity="0.6"/>
      <text x="2" y="14" font-size="12" fill="#ffd54f" opacity="0.8" font-family="serif">♪</text>
      <text x="170" y="12" font-size="10" fill="#ff8a65" opacity="0.6" font-family="serif">♫</text>
    </svg>
  </div>

  <main style="position: relative; z-index: 1">
  <!-- ═══════════════════════════════════════
       AI AGENT BANNER
  ═══════════════════════════════════════ -->
  <div class="ai-banner" role="note" aria-label="Site information">
    <span class="ai-banner-icon">⚡</span>
    <span class="ai-banner-text">
      Content updates <strong>daily</strong> — this site is self-improved, built &amp;
      deployed by an
      <strong>AI agent</strong>, served from an <strong
        >Android mobile phone</strong
      > server.
    </span>
    <span class="ai-banner-pulse"></span>
  </div>

  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section id="hero" class="hero">
    <div id="moonContainer">
      <canvas id="foregroundMoon"></canvas>
    </div>
    <div class="hero-title-wrap">
      <div class="logo-sanskrit">अत्रिज</div>
    </div>
    <div class="logo-subtitle reveal">Atrij</div>
    <p class="logo-tagline reveal" set:html={sec.hero.tagline} />
    <span class="click-hint">Click anywhere to see flute magic</span>
    <span class="scroll-hint">Scroll to explore</span>
  </section>

  <!-- ═══════════════════════════════════════
       TODAY'S REFLECTION
  ═══════════════════════════════════════ -->
  <section id="today" class="section">
    <div class="section-inner">
      <div class="section-label reveal-left">Today's Reflection</div>
      <h2 class="reveal" set:html={sec.today.heading} />
      {sec.today.visualAsset && sec.today.visualAsset.path && (
        <div class="today-visual-asset">
          <img src={sec.today.visualAsset.path} alt={sec.today.visualAsset.description || "Daily visual"} loading="lazy" />
          <div class="today-visual-caption">{sec.today.visualAsset.description}</div>
        </div>
      )}
      <div class="today-fact reveal-scale">
        <div class="theme-tag">{todayTheme.title} · {todayColor.mood}</div>
        <p>{todayFact.text}</p>
        <div class="source">{todayFact.source}</div>
      </div>
      <div class="quote-block reveal">
        <p>{todayQuote}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CONTENT SECTIONS (data-driven)
  ═══════════════════════════════════════ -->
  {
    sections.map((s) => {
      const data = sec[s.key];
      const imgFact =
        siteData.themes[data.imageCard.themeIndex].facts[
          data.imageCard.factIndex
        ];
      const quoteTheme = siteData.themes[data.quote.themeIndex];
      return (
        <section id={s.id} class="section">
          <div class="section-inner">
            <div class="section-label reveal-left">{data.label}</div>
            <h2 class="reveal" set:html={data.heading} />
            <p class="reveal">{data.intro}</p>
            <div class="fact-card reveal">
              <p>{imgFact.text}</p>
              <div class="source">{imgFact.source}</div>
            </div>
            {s.carousel ? (
              <div
                class="quote-carousel reveal"
                data-theme-index={data.quote.themeIndex}
              >
                <div class="quote-carousel-inner">
                  {quoteTheme.quotes.map((q, i) => (
                    <div
                      class="quote-card"
                      data-index={i}
                      style={i === 0 ? "" : "display:none"}
                    >
                      <div class="quote-block">
                        <p>{q}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="quote-dots">
                  {quoteTheme.quotes.map((_q, i) => (
                    <button
                      class={"quote-dot" + (i === 0 ? " active" : "")}
                      data-index={i}
                      aria-label={"Quote " + (i + 1)}
                    />
                  ))}
                </div>
              </div>
            ) : (
              <div class="quote-block reveal">
                <p>{quoteTheme.quotes[data.quote.quoteIndex]}</p>
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <!-- ═══════════════════════════════════════
       LETTERS FROM VINCENT
  ═══════════════════════════════════════ -->
  <LetterCard />

  <!-- ═══════════════════════════════════════
       PAINTING REVEAL
  ═══════════════════════════════════════ -->
  <section id="painting-reveal" class="painting-reveal-section">
    <div class="painting-reveal-caption">
      The Starry Night, 1889 — Oil on canvas
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       DAILY CONTEMPLATION (ZEN KOAN)
  ═══════════════════════════════════════ -->
  <KoanCard />

  <!-- ═══════════════════════════════════════
       CHANGELOG
  ═══════════════════════════════════════ -->
  <section id="changelog" class="section">
    <div class="section-inner changelog-section">
      <div class="section-label">Changelog</div>
      <h2>Project <em>changelog</em></h2>
      <p class="changelog-version-line">
        Version {changelogVersion} — daily mutations, features, fixes &amp; more.
      </p>
      <div id="changelog-app" class="changelog-app">
        <div class="changelog-loading">Loading…</div>
      </div>
    </div>
  </section>

  <script is:inline type="module" src="/js/changelog-app.js"></script>
  <!-- ═══════════════════════════════════════
       THREE.JS SCENE — separate Vite bundle (vite-scene.config.js)
  ═══════════════════════════════════════ -->
  <div id="vg-data" data-colors={colorData} hidden></div>
  <script is:inline src="/js/content-prefetch.js"></script>
  <script is:inline src="/js/scene-context-recovery.js"></script>
  <script is:inline src="/js/scene-error-boundary.js"></script>
  <script type="module" src="/js/scene-bundle.js" defer></script>

  <!-- ═══════════════════════════════════════
       CSS VARIABLE INJECTION
  ═══════════════════════════════════════ -->
  <script>
    (function () {
      const el = document.getElementById("vg-data");
      const c = JSON.parse(el.dataset.colors);
      const r = document.documentElement.style;
      r.setProperty("--color-primary", c.primary);
      r.setProperty("--color-secondary", c.secondary);
      r.setProperty("--color-accent", c.accent);
      r.setProperty("--color-bg", c.background);
      r.setProperty("--color-text", c.text);
    })();
  </script>
  <script is:inline type="module" src="/js/moon-phase.js"></script>
  <script is:inline src="/js/quote-carousel.js"></script>
  <script is:inline src="/js/brushstroke-cursor.js" defer></script>
  <script is:inline src="/js/theme-switcher.js" defer></script>

  <!-- Brushstroke cursor canvas -->
  <canvas
    id="brushstroke-canvas"
    data-colors="#FFD700,#4169E1,#228B22,#FF6347,#9370DB,#87CEEB"
    style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:10;"
  ></canvas>

  <!-- Daily layout variant — set by mutation cron via content.json -->
  <script is:inline>
    document.body.classList.add('layout-' + (content.meta && content.meta.layout ? content.meta.layout : 'default'));
  </script>
  <style>
    .painting-reveal-section {
      position: relative;
      height: 150vh;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 4rem;
    }
    @media (max-width: 767px) {
      .painting-reveal-section {
        height: 120vh;
      }
    }
    .painting-reveal-caption {
      font-family: var(--font-serif);
      font-size: 0.9rem;
      color: var(--text-tertiary);
      text-align: center;
      letter-spacing: 0.05em;
    }

    /* Daily visual asset in Today section */
    .today-visual-asset {
      margin: var(--space-xl) 0;
      border-radius: 12px;
      overflow: hidden;
      border: 2px solid rgba(255, 213, 79, 0.3);
      box-shadow: 0 0 30px rgba(255, 213, 79, 0.08), inset 0 0 30px rgba(255, 213, 79, 0.03);
      min-height: 200px;
      position: relative;
    }
    .today-visual-asset img {
      width: 100%;
      height: auto;
      display: block;
      opacity: 1;
    }
    .today-visual-caption {
      font-family: var(--font-serif);
      font-size: 0.9rem;
      color: var(--text-secondary);
      text-align: center;
      padding: var(--space-md) var(--space-lg);
      font-style: italic;
      background: rgba(0,0,0,0.3);
    }
  </style>
  </main>

  <footer>
    <div class="footer-sanskrit">अत्रिज</div>
    An impressionist experience in light &amp; philosophy
  </footer>

  <!-- Flute Click Handler -->
  <script>
    (function() {
      const flute = document.getElementById('flute-container');
      if (!flute) return;
      const symbols = ['♪','♫','♩','♬','♭','♮','♯'];
      const colors = ['#ffd54f','#ff8a65','#4fc3f7','#b388ff','#80cbc4','#fff8e1'];
      flute.addEventListener('click', function(e) {
        e.stopPropagation();
        const rect = flute.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        for (let i = 0; i < 12; i++) {
          (function(idx) {
            setTimeout(function() {
              const n = document.createElement('div');
              n.textContent = symbols[Math.floor(Math.random()*symbols.length)];
              n.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;font-family:serif;font-size:' + (1.0+Math.random()*0.8) + 'rem;color:' + colors[Math.floor(Math.random()*colors.length)] + ';left:' + (cx+(Math.random()-0.5)*160) + 'px;top:' + (cy+(Math.random()-0.5)*80-60) + 'px;animation:noteFloat 2.5s ease-out forwards;will-change:transform,opacity;';
              document.body.appendChild(n);
              setTimeout(function(){if(n.parentNode)n.parentNode.removeChild(n);},2600);
            }, idx*80);
          })(i);
        }
      });
    })();
  </script>
  <script is:inline>
    /* Scroll reveal — add .visible to .reveal elements when they enter viewport */
    (function() {
      const els = document.querySelectorAll('.reveal, .reveal-left, .reveal-scale');
      if (!els.length) return;

      function showEl(el) {
        if (el.classList.contains('visible')) return;
        el.classList.add('visible');
      }

      // Primary: IntersectionObserver for scroll-triggered reveal
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              showEl(e.target);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -20px 0px' });
        els.forEach(function(el) { io.observe(el); });
      }

      // Fallback 1: show all after 2s (ensures visibility even if observer fails)
      setTimeout(function() {
        els.forEach(function(el) { showEl(el); });
      }, 2000);

      // Fallback 2: show elements immediately if they're in initial viewport
      requestAnimationFrame(function() {
        els.forEach(function(el) {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            showEl(el);
          }
        });
      });
    })();
  </script>
  <script is:inline src="/js/accessibility.js"></script>
  <script is:inline type="module" src="/js/scroll-lighting.js"></script>
  <script is:inline src="/js/section-nav.js"></script>
  <script is:inline src="/js/content-search.js"></script>
  <script is:inline src="/js/keyboard-help.js"></script>
  <script is:inline src="/js/reader-mode.js"></script>
  <script is:inline src="/js/performance-scaler.js"></script>
  <script is:inline src="/js/sw-register.js"></script>
  <script is:inline src="/js/comet.js"></script>
</body>
</BaseLayout>