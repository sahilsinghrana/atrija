      var moonEl = document.getElementById('asciiMoon');
      var shadow = document.getElementById('moonShadow');
      if (!moonEl || !shadow) return;

      moonEl.textContent = moonArt;

      // ── Smooth rAF-based phase animation ──
      // Start from real current phase, then slowly cycle forward
      var lunarCycle = 29.53058867;
      var knownNewMoon = new Date(2000, 0, 6, 18, 14, 0);
      var daysSinceNew = (Date.now() - knownNewMoon.getTime()) / (1000 * 60 * 60 * 24);
      var currentPhaseDays = ((daysSinceNew % lunarCycle) + lunarCycle) % lunarCycle;

      // Target translate value (current real phase)
      var targetTranslate = 0;
      var currentTranslate = 0;

      function phaseToTranslate(phaseDays) {
        var pf = phaseDays / lunarCycle;
        var illum = (1 - Math.cos(pf * 2 * Math.PI)) / 2 * 100;
        return pf < 0.5 ? -(100 - illum) : (100 - illum);
      }

      // Set initial translate instantly
      currentTranslate = phaseToTranslate(currentPhaseDays);
      targetTranslate = currentTranslate;
      shadow.style.transform = 'translateX(' + currentTranslate.toFixed(3) + '%)';

      // Slowly advance phase: one full cycle every 60 seconds (demo speed)
      var demoSpeedDaysPerSec = lunarCycle / 60;
      var lastTime = null;

      function animateMoon(ts) {
        if (lastTime === null) lastTime = ts;
        var dt = (ts - lastTime) / 1000; // seconds
        lastTime = ts;

        currentPhaseDays = (currentPhaseDays + demoSpeedDaysPerSec * dt) % lunarCycle;
        targetTranslate = phaseToTranslate(currentPhaseDays);

        // Lerp for extra smoothness
        currentTranslate += (targetTranslate - currentTranslate) * 0.04;
        shadow.style.transform = 'translateX(' + currentTranslate.toFixed(3) + '%)';

        requestAnimationFrame(animateMoon);
      }

      requestAnimationFrame(animateMoon);
    })();
  </script>

  <!-- ── Ambient Audio: scroll listener + toggle logic ── -->
  <script is:inline>
  (function() {
    var toggle = document.getElementById('audio-toggle');
    var isPlaying = false;

    toggle.addEventListener('click', function() {
      if (!window.AmbientAudio) return;
      if (!isPlaying) {
        AmbientAudio.init();
        AmbientAudio.start();
        toggle.textContent = '🔊';
        toggle.style.color = 'rgba(255,215,79,0.9)';
        toggle.style.borderColor = 'rgba(255,215,79,0.4)';
        isPlaying = true;
      } else {
        AmbientAudio.stop();
        toggle.textContent = '🔇';
        toggle.style.color = 'rgba(255,255,255,0.6)';
        toggle.style.borderColor = 'rgba(255,255,255,0.15)';
        isPlaying = false;
      }
    });

    // Scroll depth → audio brightness
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          var scrollH = document.documentElement.scrollHeight - window.innerHeight;
          var depth = scrollH > 0 ? window.scrollY / scrollH : 0;
          if (window.AmbientAudio) AmbientAudio.setScrollDepth(depth);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Pause on tab hidden
    document.addEventListener('visibilitychange', function() {
      if (document.hidden && isPlaying && window.AmbientAudio) {
        AmbientAudio.stop();
      } else if (!document.hidden && isPlaying && window.AmbientAudio) {
        AmbientAudio.start();
      }
    });
  })();
  </script>

