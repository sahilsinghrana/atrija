---
const { title = "अत्रिज", description = "An impressionist journey through light, philosophy, and the cosmos." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet" />
  <!-- Preload critical assets -->
  <link rel="preload" href="/css/loader.css" as="style" fetchpriority="high" />
  <link rel="preload" href="/css/main.css" as="style" fetchpriority="high" />
  <link rel="stylesheet" href="/css/loader.css" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/daily-theme.css?v=TODAYS_DATE" />
  <script is:inline>
  (function() {
    var bar = document.getElementById('loader-progress-bar');
    // Simulate progress while waiting
    var fakeProgress = 0;
    var fakeInterval = setInterval(function() {
      fakeProgress += Math.random() * 15;
      if (fakeProgress > 85) { fakeProgress = 85; clearInterval(fakeInterval); }
      if (bar) bar.style.width = fakeProgress + '%';
    }, 300);
    // Hide loader when scene signals ready, or after 12s timeout
    window.__sceneLoadingStarted = function() { clearInterval(fakeInterval); };
    window.__updateLoaderProgress = function(pct) { if (bar) bar.style.width = pct + '%'; };
    window.__sceneReady = function() {
      clearInterval(fakeInterval);
      if (bar) bar.style.width = '100%';
      var l = document.getElementById('loader');
      if (l) l.classList.add('hidden');
    };
    window.__sceneFailed = function(msg) {
      clearInterval(fakeInterval);
      var s = document.getElementById('scene-error');
      var sm = document.getElementById('scene-error-msg');
      if (sm) sm.textContent = msg;
      if (s) s.style.display = 'block';
    };
    setTimeout(function() {
      clearInterval(fakeInterval);
      if (bar) bar.style.width = '100%';
      var l = document.getElementById('loader');
      if (l) l.classList.add('hidden');
      // Only show error if scene didn't signal ready
      if (!window.__sceneReady) {
        var s = document.getElementById('scene-error');
        if (s) s.style.display = 'block';
      }
    }, 12000);
  })();
  </script>
  <div id="scene-error" style="display:none;position:fixed;bottom:1rem;left:1rem;z-index:99999;background:rgba(255,0,0,0.15);color:#ff8a80;padding:0.5rem 1rem;border-radius:8px;font-size:0.8rem;font-family:sans-serif;max-width:80vw;">
    ⚠️ 3D scene failed to load: <span id="scene-error-msg" style="font-family:monospace;font-size:0.75rem;"></span>
    <button onclick="location.reload()" style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:0.2rem 0.5rem;border-radius:4px;cursor:pointer;margin-left:0.5rem;">Reload</button>
  </div>
  <style>
    :global(body) { background: linear-gradient(180deg, #0a0a1a 0%, #0d1b2a 30%, #1b2838 60%, #0a0a1a 100%); }
    :global(#canvas-container canvas) { display: block; width: 100% !important; height: 100% !important; }
  </style>
  <style>
    .skip-nav-link {
      position: absolute;
      top: -100%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 999999;
      padding: 0.75rem 1.5rem;
      background: var(--accent-gold);
      color: #08080f;
      font-family: var(--font-sans);
      font-size: var(--text-sm);
      font-weight: 600;
      border-radius: 0 0 var(--radius-md) var(--radius-md);
      text-decoration: none;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
      transition: top 0.2s ease;
    }
    .skip-nav-link:focus {
      top: 0;
      outline: 2px solid var(--accent-gold);
      outline-offset: 2px;
    }

    /* ── Accessibility: Screen-reader only utility ── */
    .sr-only {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    /* ── Accessibility: Enhanced focus-visible indicators ── */
    :focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 2px;
    }
    /* Flute button focus */
    #flute-container:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 4px;
      background: rgba(255, 213, 79, 0.15);
    }
    /* Theme switcher focus */
    .theme-switcher-toggle:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 3px;
    }
    .theme-switcher-pill:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: -2px;
      background: rgba(255, 255, 255, 0.08);
    }
    .theme-switcher-close:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 2px;
    }
    /* Quote dot focus */
    .quote-dot:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 2px;
      transform: scale(1.3);
    }
    /* Changelog button focus */
    .changelog-date-header:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: -2px;
    }
    .changelog-load-more:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 2px;
    }

    /* ── Accessibility: Respect prefers-reduced-motion ── */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
    html[data-reduced-motion="true"] .quote-card,
    html[data-reduced-motion="true"] .reveal,
    html[data-reduced-motion="true"] .reveal-left,
    html[data-reduced-motion="true"] .reveal-scale {
      transition-duration: 0.01ms !important;
    }
  </style>
  <!-- eslint-disable-next-line astro/no-unused-define-vars-in-style -->
</head>
  <slot />
</html>