---
// Tulip visualization component - no text, just animated pulsing flower
---

<section id="koan" class="section">
  <div class="section-inner">
    <div class="tulip-container">
      <canvas id="tulipCanvas" width="400" height="400"></canvas>
    </div>
  </div>
</section>

<style>
  :root {
    --tulip-stem: var(--accent-green, #2e7d32);
    --tulip-leaf: var(--accent-green-dark, #4caf50);
    --tulip-petal: var(--accent-gold, #ffd54f);
    --tulip-bg: rgba(255,255,255,0.02);
  }
  .tulip-container {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
    background: var(--tulip-bg);
    border-radius: 16px;
    overflow: hidden;
  }
  #tulipCanvas {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script>
  (function() {
    const canvas = document.getElementById('tulipCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width = canvas.width;
    let height = canvas.height;

    // Animation
    let startTime = null;
    const cycleDuration = 3000; // ms for pulse cycle

    function draw(timestamp) {
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;
      const progress = (elapsed % cycleDuration) / cycleDuration; // 0 to 1
      // pulse scale: 0.8 to 1.2
      const scale = 0.8 + 0.4 * Math.sin(progress * 2 * Math.PI);

      // Clear canvas
      ctx.clearRect(0, 0, width, height);
      ctx.save();
      // Center and scale
      ctx.translate(width / 2, height * 0.8);

      // Draw stem
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--tulip-stem').trim() || '#2e7d32';
      const stemWidth = 8;
      const stemHeight = height * 0.5;
      ctx.fillRect(-stemWidth/2, -stemHeight, stemWidth, stemHeight);

      // Draw leaves
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--tulip-leaf').trim() || '#4caf50';
      const leafWidth = 20;
      const leafHeight = 40;
      // Left leaf
      ctx.save();
      ctx.translate(-stemWidth/2 - 5, -stemHeight * 0.3);
      ctx.rotate(-0.3);
      drawEllipse(0, 0, leafWidth/2, leafHeight/2);
      ctx.restore();
      // Right leaf
      ctx.save();
      ctx.translate(stemWidth/2 + 5, -stemHeight * 0.3);
      ctx.rotate(0.3);
      drawEllipse(0, 0, leafWidth/2, leafHeight/2);
      ctx.restore();

      // Draw flower (pulsing circle)
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--tulip-petal').trim() || '#ffd54f';
      const baseRadius = 20;
      const radius = baseRadius * scale;
      ctx.beginPath();
      ctx.arc(0, -stemHeight * 0.2, radius, 0, 2 * Math.PI);
      ctx.fill();

      // Optional: add a small center
      ctx.fillStyle = '#ff6f00';
      ctx.beginPath();
      ctx.arc(0, -stemHeight * 0.2, radius * 0.3, 0, 2 * Math.PI);
      ctx.fill();

      ctx.restore();
      requestAnimationFrame(draw);
    }

    function drawEllipse(x, y, radiusX, radiusY) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(1, radiusY/radiusX);
      ctx.beginPath();
      ctx.arc(0, 0, radiusX, 0, 2*Math.PI);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    // Handle resize
    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const size = Math.min(rect.width, rect.height);
      canvas.width = size;
      canvas.height = size;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    requestAnimationFrame(draw);
  })();
</script>