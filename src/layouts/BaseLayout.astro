---
const { title = "Selene", description = "An impressionist journey through light, philosophy, and the cosmos." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #08080f;
      --bg-card: rgba(255,255,255,0.03);
      --bg-card-hover: rgba(255,255,255,0.06);
      --border: rgba(255,255,255,0.08);
      --border-accent: rgba(255,213,79,0.3);
      --text: #e8e6e1;
      --text-dim: rgba(232,230,225,0.6);
      --text-muted: rgba(232,230,225,0.4);
      --gold: #ffd54f;
      --gold-dim: rgba(255,213,79,0.15);
      --blue: #4fc3f7;
      --blue-dim: rgba(79,195,247,0.12);
      --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
      --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --max-w: 720px;
      --nav-h: 60px;
    }

    html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ── Canvas Background ── */
    #canvas-container {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    /* ── Navigation ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      height: var(--nav-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      background: rgba(8,8,15,0.85);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      border-bottom: 1px solid var(--border);
    }
    nav .logo {
      font-family: var(--serif);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--gold);
      text-decoration: none;
      letter-spacing: 0.02em;
    }
    nav .logo span { font-weight: 400; opacity: 0.6; }
    .nav-links { display: flex; gap: 0; list-style: none; }
    .nav-links a {
      display: block;
      padding: 0.5rem 1rem;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }
    .nav-links a:hover { color: var(--gold); background: var(--gold-dim); }

    /* ── Main Content ── */
    main {
      position: relative;
      z-index: 1;
      padding-top: var(--nav-h);
    }

    /* ── Hero ── */
    .hero {
      min-height: calc(100vh - var(--nav-h));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 3rem 2rem;
      position: relative;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 50%;
      transform: translateX(-50%);
      width: 1px; height: 80px;
      background: linear-gradient(to bottom, var(--gold), transparent);
      opacity: 0.4;
    }
    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(3.5rem, 10vw, 7rem);
      font-weight: 700;
      color: var(--text);
      line-height: 1;
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }
    .hero h1 em {
      font-style: italic;
      font-weight: 400;
      color: var(--gold);
    }
    .hero p {
      font-family: var(--serif);
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--text-dim);
      font-style: italic;
      max-width: 500px;
    }
    .hero .scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      color: var(--text-muted);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      animation: fadeUp 2s ease-in-out infinite;
    }
    @keyframes fadeUp {
      0%, 100% { opacity: 0.3; transform: translateX(-50%) translateY(0); }
      50% { opacity: 0.8; transform: translateX(-50%) translateY(-8px); }
    }

    /* ── Section Base ── */
    .section {
      padding: 6rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .section-inner {
      width: 100%;
      max-width: var(--max-w);
    }
    .section-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-accent);
      max-width: 60px;
    }
    .section h2 {
      font-family: var(--serif);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 600;
      color: var(--text);
      line-height: 1.15;
      margin-bottom: 2rem;
    }
    .section h2 em { font-style: italic; font-weight: 400; }
    .section > .section-inner > p {
      font-size: 1.05rem;
      color: var(--text-dim);
      margin-bottom: 1.5rem;
      max-width: 600px;
    }

    /* ── Image Cards ── */
    .image-card {
      position: relative;
      width: 100%;
      margin: 2.5rem 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .image-card img, .image-card svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .image-card .image-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(8,8,15,0.7) 0%, transparent 40%);
      pointer-events: none;
    }

    /* ── Fact Cards ── */
    .fact-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem 1.75rem;
      margin: 1.25rem 0;
      transition: background 0.2s, border-color 0.2s;
    }
    .fact-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(255,255,255,0.12);
    }
    .fact-card p {
      font-size: 0.95rem;
      color: var(--text-dim);
      line-height: 1.7;
    }
    .fact-card .source {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      font-style: italic;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .fact-card .source::before {
      content: '—';
      color: var(--gold);
      opacity: 0.5;
    }

    /* ── Quote Block ── */
    .quote-block {
      text-align: center;
      padding: 2.5rem 2rem;
      margin: 2rem 0;
      position: relative;
    }
    .quote-block::before {
      content: '“';
      font-family: var(--serif);
      font-size: 4rem;
      color: var(--gold);
      opacity: 0.2;
      position: absolute;
      top: 0.5rem;
      left: 50%;
      transform: translateX(-50%);
      line-height: 1;
    }
    .quote-block p {
      font-family: var(--serif);
      font-size: clamp(1.2rem, 3vw, 1.6rem);
      font-style: italic;
      font-weight: 400;
      color: var(--text);
      line-height: 1.5;
      position: relative;
      z-index: 1;
    }

    /* ── Today Section ── */
    .today-fact {
      background: linear-gradient(135deg, var(--gold-dim), var(--blue-dim));
      border: 1px solid var(--border-accent);
      border-radius: 12px;
      padding: 2rem;
      margin: 2rem 0;
    }
    .today-fact .label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
    }
    .today-fact .theme-tag {
      display: inline-block;
      font-size: 0.75rem;
      color: var(--text-muted);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.2rem 0.6rem;
      margin-bottom: 1rem;
    }
    .today-fact p {
      font-size: 1rem;
      color: var(--text);
      line-height: 1.7;
    }
    .today-fact .source {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      font-style: italic;
    }

    /* ── Changelog ── */
    .changelog-section { padding-bottom: 4rem; }
    .changelog-entry {
      border-left: 2px solid var(--border);
      padding-left: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .changelog-entry .date {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--gold);
      margin-bottom: 0.25rem;
    }
    .changelog-entry .desc {
      font-size: 0.9rem;
      color: var(--text-dim);
      margin-bottom: 0.5rem;
    }
    .changelog-entry ul {
      list-style: none;
      padding: 0;
    }
    .changelog-entry li {
      font-size: 0.8rem;
      color: var(--text-muted);
      padding: 0.15rem 0;
      padding-left: 1rem;
      position: relative;
    }
    .changelog-entry li::before {
      content: '·';
      position: absolute;
      left: 0;
      color: var(--gold);
      opacity: 0.5;
    }

    /* ── Footer ── */
    footer {
      text-align: center;
      padding: 3rem 2rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.8rem;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .nav-links { gap: 0; }
      .nav-links a { padding: 0.4rem 0.7rem; font-size: 0.75rem; }
      .section { padding: 4rem 1.25rem; }
      .hero { padding: 2rem 1.25rem; }
      .hero h1 { font-size: clamp(2.5rem, 12vw, 4.5rem); }
      .fact-card { padding: 1.25rem; }
      .today-fact { padding: 1.5rem; }
      .image-card { margin: 1.5rem 0; border-radius: 8px; }
    }
    @media (max-width: 480px) {
      nav { padding: 0 1rem; }
      .nav-links { display: none; }
      .section { padding: 3rem 1rem; }
      .quote-block { padding: 1.5rem 1rem; }
      .quote-block::before { font-size: 3rem; }
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>

  <nav>
    <a href="#hero" class="logo">Selene<span>.</span></a>
    <ul class="nav-links">
      <li><a href="#today">Today</a></li>
      <li><a href="#moon">Moon</a></li>
      <li><a href="#philosophy">Philosophy</a></li>
      <li><a href="#gita">Gita</a></li>
      <li><a href="#shiva">Shiva</a></li>
      <li><a href="#art">Art</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    Selene — An impressionist experience in light &amp; philosophy
  </footer>
</body>
</html>
